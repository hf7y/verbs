#!/usr/bin/env bash
# vim-arcade -- play your live GitHub issue/PR queue as a vim-arcade level.
#
# Clearing a row with an ordinary vim motion triages that item for real.
#
# TWO VIEWS. The default plays ONE repo, resolved by `gh` from the caller's
# current directory. `--map` plays the WHOLE WORLD: every repo on `hf7y` and
# `media-arts-collective`, discovered live (vim_arcade/discovery.py), never a
# hardcoded list. A repo with no open issues or PRs has no tile -- which is
# why vim-arcade itself is usually absent from its own map.
#
# WHY THE ENGINE IS BESIDE THIS SCRIPT AND NOT ACROSS THE FILESYSTEM
# ------------------------------------------------------------------
# Its engine is a built archive, dist/vim-arcade.pyz -- carried on this same
# branch by .github/workflows/carry-zipapp.yml on every push to main, see
# issue #131 -- and it sits at the root of whatever tree this script was
# checked out into. A standalone shallow clone of `bashified`, with no
# vim-arcade dev clone anywhere on the machine, is a complete and working
# game. See README "Verify" for how far that is actually proved, which is
# less far than this comment used to claim.
#
# VIM_ARCADE_ENGINE_ROOT overrides the engine location, for a developer who
# wants the game pointed at a live source checkout (vim_arcade/, not a
# built pyz) instead. It is an override, not the default, because a default
# that reaches outside its own tree is the failure above.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=vim-arcade
VERB_SUMMARY="play your live GitHub issue/PR queue as a vim-arcade level"
VERB_USAGE="vim-arcade [--map] [--live]"
VERB_CAN_SUMMON=0
VERB_CAN_WRITE=1
# vim-arcade reaches 0, 2, 5, 6 and 7. It never reaches 3 or 4: it has no summon,
# and it has no subcommand that is contracted-but-unbuilt. Advertising codes
# it cannot return would make --help and the man page disagree.
VERB_EXITS="0 kept  2 usage  5 broken  6 blind  7 refused"
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

ENGINE_ROOT="${VIM_ARCADE_ENGINE_ROOT:-$SELF}"
PYZ="$SELF/dist/vim-arcade.pyz"
# Overridden root means "run from source"; unoverridden means "run the
# carried build" -- a dev checkout pointed here has vim_arcade/, not a pyz.
USE_PYZ=1
[ "$ENGINE_ROOT" = "$SELF" ] || USE_PYZ=0

# --live and --map are vim-arcade's own flags and the shared runtime knows nothing
# about them, so they are taken out before verb_parse sees the line. Without
# this arm they reach `-*) verb_die "unknown flag"` and vim-arcade's own --help
# would contradict vim-arcade -- the exact defect bab1de1 fixed in bin/entraine.
LIVE=0
MAP=0
rest=()
for a in "$@"; do
  case "$a" in
    --live) LIVE=1 ;;
    --map)  MAP=1 ;;
    *)      rest+=("$a") ;;
  esac
done

verb_parse "${rest[@]+"${rest[@]}"}"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"
[ $# -eq 0 ] || verb_die "vim-arcade takes no positional arguments (got: $1)"

# --force is advertised by the shared runtime's --help for any verb that can
# write, so it must mean something here rather than be silently swallowed.
# What it would override is the ONE refusal vim-arcade has, and that refusal is not
# flag-overridable on purpose -- see REFUSALS in man/vim-arcade.1.
[ "$VERB_FORCE" = 1 ] && verb_refuse \
  "--force would override merge_safety's local refusal, which no flag lifts. A refused merge is refused for a named reason (conflict, draft, blocked checks, superseded content); fix the reason, or press m twice in the detail panel for the title/diff-mismatch warning, which is the only second-look vim-arcade offers."

# Dry run is the default, and --dry-run is how a caller states it rather
# than relies on it. If both are given, the one that changes nothing wins:
# a line that both authorises and forbids writing is a caller who does not
# know which they meant, and guessing "write" is the expensive guess.
if [ "$VERB_DRYRUN" = 1 ] && [ "$LIVE" = 1 ]; then
  printf '%s: --dry-run and --live were both given; --dry-run wins, nothing will be written.\n' "$VERB_NAME" >&2
  LIVE=0
fi

# ------------------------------------------------------------------ probes
# Each of these is a DIFFERENT world-state and gets a different exit code.
# "the engine is missing" (5) and "I cannot read the queue" (6) are the two
# that a single nonzero would have flattened into one useless signal.

if [ "$USE_PYZ" = 1 ]; then
  [ -f "$PYZ" ] || verb_broke \
    "no built engine at $PYZ -- this checkout is incomplete (see bin/build-zipapp.sh and .github/workflows/carry-zipapp.yml)"
else
  [ -f "$ENGINE_ROOT/vim_arcade/gh_game.py" ] || verb_broke \
    "no engine at $ENGINE_ROOT/vim_arcade/gh_game.py -- VIM_ARCADE_ENGINE_ROOT points at an incomplete checkout"
fi

command -v python3 >/dev/null 2>&1 || verb_broke \
  "python3 is not on PATH; the engine is stdlib-only Python and cannot run without it"

command -v gh >/dev/null 2>&1 || verb_blind \
  "gh is not installed, and the queue vim-arcade plays IS gh's view of this repository"

if [ ! -t 0 ] || [ ! -t 1 ]; then
  verb_blind "no terminal to render into (stdin or stdout is not a TTY); vim-arcade is a curses front end"
fi

# Plain `gh auth status`, NOT `gh auth status --active`. The --active form
# reads better and was written first; it does not exist before gh 2.60 and
# the installed gh here is 2.45.0, where it exits 1 with "unknown flag" --
# which this probe read as "not authenticated" and reported as BLIND on a
# perfectly authenticated machine. A guard that goes blind when it can see
# is worse than no guard: it is a false negative wearing a safety warning.
# Caught 2026-08-04 by running the verb under a pty rather than trusting it.
gh auth status >/dev/null 2>&1 || verb_blind \
  "gh is not authenticated, so the open-item count would be zero for a reason that has nothing to do with your queue being empty"

# ------------------------------------------------------------------ launch
args=()
[ "$MAP" = 1 ] && args+=(--map)
[ "$LIVE" = 1 ] && args+=(--live)

if [ "$USE_PYZ" = 1 ]; then
  exec python3 "$PYZ" "${args[@]+"${args[@]}"}"
else
  export PYTHONPATH="$ENGINE_ROOT${PYTHONPATH:+:$PYTHONPATH}"
  exec python3 -m vim_arcade.gh_game "${args[@]+"${args[@]}"}"
fi
