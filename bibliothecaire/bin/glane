#!/usr/bin/env bash
# glane -- harvest page ninety-two from many public-domain texts.
#
# The harvesting wing of bibliothecaire, fronting bin/page92.py, which already
# holds the politeness ceiling (one source, sequential, fixed delay, honest
# User-Agent, hard cap per run) and the stated pagination rule.
#
# WHY THIS IS A TRANSLATION LAYER AND NOT MORE. The audit that preceded it
# found fetch, extract, rule, order and status already backed by a command on
# page92.py -- three of them added in this same pass, because `rule`, `order`
# and `status` are readings of numbers page92.py already owns and retyping
# those numbers into shell is exactly the two-sources drift the discipline
# forbids. What page92.py lacks is a caller-facing failure vocabulary: it
# exits 1 for every failure, so "cache is empty" and "I cannot read the tree"
# are indistinguishable at the exit code. Translating that is this file's job.
#
# WHAT THIS FILE DELIBERATELY DOES NOT DO. It does not order, group, rank or
# lay out what it harvests, and there is no flag here that turns that on.
# Arranging is the work itself and it is a human act; see accroche(1), which
# also does not do it.

VERB_NAME="glane"
VERB_SUMMARY="harvest page ninety-two from many public-domain texts"
# glane never spends money. `fetch` reaches one public archive that charges
# nothing; every other subcommand is local. The flag is therefore absent
# entirely, so --help answers the cost question by not offering it.
VERB_CAN_SUMMON=0
VERB_USAGE="glane [list|status]
       glane fetch [--count N]
       glane extract
       glane rule"

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/verb.sh
. "$ROOT/lib/verb.sh"

# The harvest tree. Read from ONE place; never retyped per subcommand, and
# exported so page92.py resolves the same tree this verb reports on.
GLANE_ROOT="${GLANE_ROOT:-$ROOT}"
export GLANE_ROOT
HARVEST="$ROOT/bin/page92.py"

# THE MAPPING, in one place. `list` reads this same table, so the report
# cannot drift from the dispatch -- a listing kept as a second hand-written
# list is how a tool comes to lie about itself.
subcommand_cmd() {
  case "$1" in
    fetch)   printf 'fetch' ;;
    extract) printf 'extract' ;;
    rule)    printf 'rule' ;;
    status)  printf 'status' ;;
    list)    printf 'self' ;;
    *)       return 1 ;;
  esac
}
SUBCOMMANDS="extract fetch list rule status"

# ---- list ------------------------------------------------------------------
# Whether tooling backs a subcommand is ASKED of the implementation, not
# asserted here: each mapped command is looked for in page92.py's own usage.
# A command renamed upstream reports GAP instead of silently dispatching into
# an error.
do_list() {
  local usage="" s c state
  # page92.py with no arguments prints its usage and exits nonzero, by design.
  [ -r "$HARVEST" ] && usage="$(python3 "$HARVEST" 2>&1)"
  [ -n "$usage" ] || verb_blind "cannot read the implementation at $HARVEST, so what backs each subcommand is unknown"

  if [ "$VERB_JSON" = 1 ]; then
    printf '{'
    local first=1
    for s in $SUBCOMMANDS; do
      c="$(subcommand_cmd "$s")"
      if [ "$c" = self ] || printf '%s' "$usage" | grep -q -- "page92.py $c"; then
        state=MECHANIZED; else state=GAP; fi
      [ "$first" = 1 ] || printf ','
      first=0
      printf '"%s":"%s"' "$s" "$state"
    done
    printf '}\n'
    return 0
  fi

  for s in $SUBCOMMANDS; do
    c="$(subcommand_cmd "$s")"
    if [ "$c" = self ] || printf '%s' "$usage" | grep -q -- "page92.py $c"; then
      state=MECHANIZED; else state=GAP; fi
    printf '%-13s %s\n' "$state" "$s"
  done
}

# ---- everything else -------------------------------------------------------
do_stage() {
  local sub="$1"; shift
  local c; c="$(subcommand_cmd "$sub")" || verb_die "unknown subcommand: $sub"
  [ -r "$HARVEST" ] || verb_blind "no harvest implementation at $HARVEST"

  local err rc
  err="$(mktemp)" || verb_broke "cannot create a temporary file"
  ( cd "$GLANE_ROOT" && python3 "$HARVEST" "$c" "$@" ) 2> >(tee "$err" >&2)
  rc=$?
  [ "$rc" = 0 ] && { rm -f "$err"; return 0; }

  # page92.py exits 1 for every failure. Split it into the page's vocabulary
  # rather than handing a caller an undocumented code: a run that could not
  # SEE its material is blind, which is a different fact from a run that saw
  # it and failed. An empty harvest reported as a clean run is the thing this
  # whole distinction exists to prevent.
  local msg; msg="$(cat "$err")"; rm -f "$err"
  case "$msg" in
    *"No such file"*|*"Permission denied"*|*"cannot open"*|*"not readable"*)
      verb_blind "$sub: cannot read the tree it was asked to work on" ;;
    *"is empty"*|*"nothing fetched"*|*"produced nothing"*)
      verb_broke "$sub: ran with valid arguments and produced nothing" ;;
    *"URLError"*|*"HTTPError"*|*"timed out"*|*"Temporary failure"*)
      verb_blind "$sub: the archive did not answer; this is not an empty archive" ;;
    *)
      verb_broke "$sub: ran with valid arguments and did not finish" ;;
  esac
}

# ---- dispatch --------------------------------------------------------------
# The subcommand and --count are lifted out before the shared runtime parses,
# because the runtime rejects any flag it does not know and --count belongs to
# fetch alone.
SUB=""
PASS=()
RUNTIME=()
while [ $# -gt 0 ]; do
  case "$1" in
    extract|fetch|list|rule|status)
      if [ -z "$SUB" ]; then SUB="$1"; else PASS+=("$1"); fi ;;
    --count) PASS+=("$1"); shift; [ $# -gt 0 ] || verb_die "--count: needs a number"
             PASS+=("$1") ;;
    --count=*) PASS+=("$1") ;;
    # Named so that asking this utility to arrange is refused as the wrong
    # request rather than deferred as a gap -- exit 4 would promise it later,
    # and there is nothing to promise.
    sort|order|arrange|group|rank|shuffle|layout)
      verb_die "arranging is not this utility's to do; that is the work itself (see accroche)" ;;
    *) RUNTIME+=("$1") ;;
  esac
  shift
done

verb_parse ${RUNTIME[@]+"${RUNTIME[@]}"}
set -- ${VERB_ARGS[@]+"${VERB_ARGS[@]}"}

# A word that is not a subcommand must be REFUSED, not left over. Without
# this, `glane nosuchthing` fell through to the default subcommand and exited
# 0 having reported on something the caller never asked about -- an exit-0
# wrong answer, which is the one failure this whole vocabulary exists to make
# impossible. Found by provoking the documented exit codes, not by reading.
if [ -z "$SUB" ] && [ $# -gt 0 ]; then
  verb_die "unknown subcommand: $1  (try: glane list)"
fi

# --json is honoured by `list` alone. On any other subcommand it is a GAP and
# says so, rather than being parsed and dropped: a flag silently ignored is a
# caller lied to. Exit 4 because the wiring genuinely does not exist -- the
# caller asked for something reasonable that nothing here implements.
if [ "$VERB_JSON" = 1 ] && [ "${SUB:-status}" != "list" ]; then
  verb_gap "--json: not wired for this subcommand"
fi

case "${SUB:-status}" in
  list)
    [ ${#PASS[@]} -eq 0 ] && [ $# -eq 0 ] || verb_die "list: takes no arguments"
    do_list ;;
  fetch)
    do_stage fetch ${PASS[@]+"${PASS[@]}"} ;;
  *)
    # A flag belonging to another subcommand is a usage error, not a silent
    # drop.
    [ ${#PASS[@]} -eq 0 ] || verb_die "${SUB:-status}: does not take ${PASS[0]}"
    do_stage "${SUB:-status}" ;;
esac
