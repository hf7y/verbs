#!/usr/bin/env bash
# range -- shelve, catalogue and retrieve the ecosystem's texts
#
# A plain shell utility. It costs nothing to run and reaches no paid service
# except where a subcommand explicitly declares a summon.
#
# The subcommand table below was DISCOVERED from tooling that actually exists
# in this tree, not invented. A subcommand backed by a script execs it. One
# the contract names but has nothing behind it reports GAP (exit 4) rather
# than pretending, because an exit-0 no-op is the worst failure available.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=range
VERB_SUMMARY="shelve, catalogue and retrieve the ecosystem's texts"
VERB_USAGE="range <subcommand> [args...]"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

# Where the implementation lives, for subcommands that exec it. Read from ONE
# place; never retyped per subcommand.
#
# This used to default to /home/zach/Documents/Projects/bibliothecaire -- the
# DEV CLONE, on one host, by absolute path. Every subcommand below was then a
# wrapper around a file that was not on this branch, so:
#   - the verb could not run from a verb build without the clone beside it,
#     which is what kept 88M of clone pinned to mandark after the build was
#     supposed to have freed it; and
#   - `fauche` could call that clone REMOVABLE (it checks byte recoverability)
#     while deleting it would have broken this verb.
# The scripts now live on this branch at the same relative paths, so the
# default is the branch root and the verb is self-contained. The override
# stays: pointing it back at a clone is still legitimate for development.
LEGACY_ROOT="${RANGE_LEGACY_ROOT:-$SELF}"

verb_subcommands() {
  printf '%s\n' \
    'install-intake-share         run smb/install-intake-share.sh' \
    'install                      run systemd/install.sh' \
    ''
}

# A leading flag is a flag, not a subcommand. Without this arm `--json`,
# `--quiet` and `--version` reach the subcommand table, exit 2 as "unknown
# subcommand", and contradict this verb's own `--help`, which offers all
# three. The generator's template shipped without the arm that `bin/bashify`
# had already grown for itself.
case "${1:-}" in
  -*) cmd=list ;;
  *)  cmd="${1:-}"; [ $# -gt 0 ] && shift ;;
esac
verb_parse "$@"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"

case "$cmd" in
  ''|list)
    printf '%s -- %s\n\n' "$VERB_NAME" "$VERB_SUMMARY"
    printf 'subcommands (discovered from real tooling):\n'
    verb_subcommands | sed '/^$/d' | sed 's/^/  /'
    printf '\n(`%s --help` for flags, `man %s` for the contract)\n' "$VERB_NAME" "$VERB_NAME"
    ;;
  help|--help|-h) verb_usage ;;
  install-intake-share)
    [ -x "$LEGACY_ROOT/smb/install-intake-share.sh" ] || verb_gap 'install-intake-share: smb/install-intake-share.sh is not executable or not present'
    exec "$LEGACY_ROOT/smb/install-intake-share.sh" "$@" ;;
  install)
    [ -x "$LEGACY_ROOT/systemd/install.sh" ] || verb_gap 'install: systemd/install.sh is not executable or not present'
    exec "$LEGACY_ROOT/systemd/install.sh" "$@" ;;
  *) verb_die "unknown subcommand: $cmd  (try: $VERB_NAME list)" ;;
esac
