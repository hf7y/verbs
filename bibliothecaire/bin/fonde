#!/usr/bin/env bash
# fonde -- admit material into the library only on a citation that checks out.
#
# The verb of bibliothecaire's corpus wing. It fronts programs that already
# work and live in the library tree, and it escalates the one action its page
# contracts but nothing yet implements.
#
# WHY THIS FILE IS THIN: the corpus subcommand is a translation layer, not a
# reimplementation. bin/validate-quotes.py holds the honesty policy and is
# already correct; what it lacks is a caller-facing failure vocabulary, since
# it signals every failure with sys.exit(1). Translating that here is the
# smallest change that makes "the ledger is unreadable" and "the material was
# refused" distinguishable to a caller, which the page test flagged as this
# verb's one non-structural defect.

VERB_NAME="fonde"
VERB_SUMMARY="admit material into the library only on a citation that checks out"
VERB_CAN_SUMMON=1
# NOT A TYPO AND NOT A DISCLAIMER. Every action this verb contracts is now
# implemented on this branch, so no run of it can reach an agent. The flag is
# still accepted, and still means what verb.sh says it means -- permission to
# spend IF AND ONLY IF no mechanism exists -- which here is permission that is
# never exercised. Keeping it is what makes `fauche`'s printed remedy
# (`fonde consign --summon <file>`) keep working instead of becoming a usage
# error the day the work it names became free.
VERB_SUMMON_COST="nothing -- consign is mechanized in this verb, so no summon is reachable"
# A verb must not advertise a code it cannot return: --help and the man page
# are the same promise stated twice, and the page test reads both directions.
# 3 (needs-summon) and 4 (gap) went out with the basheur routing.
VERB_EXITS="0 kept  2 usage  5 broken  6 blind  7 refused"
# Every flag is spelled out rather than collapsed to --require-*: the page test
# reads this text as the tool's own surface and compares it against the page in
# both directions, so a glob here reads as a flag literally named "--require-".
VERB_USAGE="fonde [corpus] [--briefs] [--sources] [--coverage] [--export] [--vault PATH]
       fonde corpus [--require-briefs] [--require-sources] [--require-coverage]
       fonde consign <path>...   DEPRECATED -- use \`consigne <path>...\`
                                 instead. Same mechanism; still works here."

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/verb.sh
. "$ROOT/lib/verb.sh"

# ---- config, read here and nowhere else -----------------------------------
# The verb tree and the library tree are deliberately separate: the bashified
# branch carries the tool, the default branch carries the corpus the tool acts
# on. Naming both here is what keeps that split from being retyped per file.
#
# $HOME, not a hardcoded /home/zach: that path only resolved on one host and
# BLINDed every other checkout of this branch that didn't know to override it.
LIBRARY="${BIBLIOTHECAIRE_HOME:-$HOME/Documents/Projects/bibliothecaire}"
# THE DEFAULT MOVED, 2026-08-12, Zach-directed ("vault moves off of any local
# host"): out of one user's home and onto the FHS location for data a system
# serves. A local clone there is a CACHE of the private hf7y/ecosystem1-vault
# remote, which is the vault. $HOME was already better than the hardcoded
# /home/zach it replaced, and still meant a different vault per account on a
# host with thirteen of them.
VAULT_DEFAULT=/srv/ecosystem1-vault
VAULT="${BIBLIOTHECAIRE_VAULT:-$VAULT_DEFAULT}"   # --vault beats both, below

verb_refuse() { printf '%s: REFUSED: %s\n' "$VERB_NAME" "$*" >&2; exit 7; }

# ---- corpus ----------------------------------------------------------------
do_corpus() {
  local prog="$LIBRARY/bin/validate-quotes.py"
  [ -r "$prog" ] || verb_blind "no quote validator at $prog (is BIBLIOTHECAIRE_HOME right?)"

  # THE BRIEFS FOLLOW THE PROSE. Once this project is reaped, briefs/ is in the
  # vault and not in the library tree, so the brief check is pointed there
  # rather than reporting every concept missing forever. An unreaped checkout
  # still has briefs/ and is left alone, so this is a fallback and not a
  # redirect. Set BIBLIOTHECAIRE_BRIEFS to override either way.
  if [ -z "${BIBLIOTHECAIRE_BRIEFS:-}" ] && [ ! -d "$LIBRARY/briefs" ]; then
    # The project name is written out rather than derived from the checkout's
    # basename: this verb belongs to bibliothecaire, and a renamed or copied
    # checkout would otherwise point the brief check at a vault directory that
    # does not exist and report every concept missing.
    export BIBLIOTHECAIRE_BRIEFS="$VAULT/bibliothecaire/briefs"
  fi

  local err rc
  err="$(mktemp)" || verb_broke "cannot create a temporary file"
  # The library tree is the working directory on purpose: the validator
  # resolves quotes/, briefs/ and sources/ relative to itself.
  ( cd "$LIBRARY" && python3 "$prog" "$@" ) 2> >(tee "$err" >&2)
  rc=$?

  if [ "$rc" = 0 ]; then rm -f "$err"; return 0; fi

  # Translate the validator's single exit 1 into the page's vocabulary. The
  # three messages below are the only ones that mean "the record itself cannot
  # be read"; every other failure is material that was read and refused.
  local msg; msg="$(cat "$err")"; rm -f "$err"
  case "$msg" in
    *"quotes.json"*"missing"*|*"not valid JSON"*|*"non-empty JSON array"*)
      verb_broke "the quote record cannot be read; the library cannot be founded on it" ;;
    *"FAIL"*)
      verb_refuse "the material was read and did not hold" ;;
    *)
      verb_broke "the quote validator exited $rc without a recognised failure" ;;
  esac
}

# ---- consign ---------------------------------------------------------------
# MECHANIZED, AND THE MECHANISM IS ON THIS BRANCH. lib/consign-prose.sh does
# the deposit. Nothing is summoned, nothing is spent, and no other repository
# has to be present for this subcommand to work.
#
# WHAT THIS REPLACED. Until 2026-08-06 the block below ran
#
#     basheur run consign-prose "$VAULT" "$@"
#
# and, before that, refused unless it saw `basheur` on PATH. **basheur was
# retired on 2026-08-05 and its clone removed from mandark**, so from that day
# `fonde consign` exited 4 -- "basheur is not on PATH, so no summon can be
# routed through the contract store" -- for every caller. Loud and correct,
# and still a dead end: the thing it was routing to is a plain bash script
# that never needed a contract store to run.
#
# The routing existed to ask exactly one question: MECHANIZED (exec the impl,
# spend nothing, say so) or AGENT (summon one)? For `consign-prose` that was
# answered on 2026-08-01, the answer cannot come out differently again, and
# the impl is now carried here. There is nothing left to ask and nobody left
# to ask it, so the question is gone rather than stubbed.
#
# WHAT WAS NOT RELAXED. The reason this verb asked instead of assuming is
# preserved exactly: it must not gate free work behind a cost flag. Before
# 2026-08-05 it did, and `fauche` -- which refuses to clear a repo whose prose
# is unconsigned and names this command as the remedy -- made 76 prose files
# across the estate look like 76 agent turns. They were zero then and they are
# zero now. What changed is that the answer is carried rather than fetched.
#
# WHAT WOULD MAKE THIS WRONG. If a contract store returns to PATH -- basheur
# revived, or a successor -- this file holds a SECOND COPY of an impl that
# store also holds, and two copies drift. The fix then is to route to the
# store again, not to keep both; see GAPS.md.

# ---- the pointer to the new door -------------------------------------------
# Zach, 2026-08-10: "make consigne equivalent or backwards compatible with
# fonde consign and have fonde consign loudly point to consigne as the new
# correct approach."
#
# `consigne` (hf7y/realisateur, bin/consigne) runs THIS FILE'S mechanism --
# lib/consign-prose.sh, located at runtime, not copied -- with the same argv
# and the same $VAULT from the same BIBLIOTHECAIRE_VAULT. So the two doors are
# one implementation, and this one is the old one.
#
# IT KEEPS WORKING, AND THAT IS THE DESIGN, NOT A SOFTENING. `fauche` refuses
# to clear a repo whose prose has no vault note and prints `fonde consign
# --summon <file>` as the remedy. Breaking this subcommand would break
# fauche's entire unconsigned-prose path against a replacement that is not on
# every host yet. A deprecation that breaks its callers is not a redirect.
#
# LOUD MEANS ON EVERY RUN, NOT IN THE PAGE. This estate's recurring defect is
# the silent no-op, and a deprecation nobody is told about is that shape
# wearing a comment. So: stderr, every invocation, before any work. stderr and
# not stdout because the impl's own DEPOSITED / "safe to remove" report is the
# caller's machine-readable output and must stay uncontaminated.
#
# AND IT DOES NOT NAME A COMMAND THAT MAY NOT EXIST. `consigne` reaches a host
# through the dated verb build, so there is a window in which the new door is
# named and not installed. Pointing an operator at a command that exits 127 is
# realisateur#112's defect -- `consulte` mandated while absent from mandark's
# build -- repeated. So this PROBES, and says which of the two situations the
# reader is actually in.
consign_pointer() {
  printf '%s: NOTE: `%s consign` is the OLD door. The new one is `consigne <path>...`\n' \
    "$VERB_NAME" "$VERB_NAME" >&2
  if command -v consigne >/dev/null 2>&1; then
    printf '%s:       (realisateur). It runs this same mechanism and also answers what a\n' "$VERB_NAME" >&2
    printf '%s:       deposit leaves behind -- `consigne status`. It is installed here; prefer it.\n' "$VERB_NAME" >&2
  else
    printf '%s:       (realisateur). It runs this same mechanism and also answers what a\n' "$VERB_NAME" >&2
    printf '%s:       deposit leaves behind -- `consigne status`. It is NOT on this host yet,\n' "$VERB_NAME" >&2
    printf '%s:       so this door is still the working one. Nothing is wrong; carry on.\n' "$VERB_NAME" >&2
  fi
}

do_consign() {
  # FIRST, before even the arity check. A caller who typed this subcommand at
  # all must learn it has been superseded -- including the one who typed it
  # wrong. The one outcome ruled out is using the old door and not being told.
  consign_pointer

  [ $# -gt 0 ] || verb_die "consign: needs at least one path"

  local p
  for p in "$@"; do
    [ -e "$p" ] || verb_die "consign: no such path: $p"
    [ -r "$p" ] || verb_blind "consign: cannot read $p"
  done
  [ -d "$VAULT" ] || verb_blind "consign: no vault at $VAULT (set BIBLIOTHECAIRE_VAULT)"
  [ -d "$VAULT/.git" ] || verb_refuse "consign: the vault at $VAULT is not under version control; a deposit there would be the only copy with no history behind it"

  local impl="$ROOT/lib/consign-prose.sh"
  # A missing mechanism is BROKEN, not a GAP. A gap is "in scope, not built
  # yet"; this is built, and this verb is supposed to be carrying it. Reporting
  # a mutilated checkout as an unbuilt feature would invite a summon to build
  # what is already written.
  [ -r "$impl" ] \
    || verb_broke "consign: the deposit mechanism is missing at $impl; this verb is supposed to carry it"

  # --summon is accepted here and buys nothing, deliberately, and it SAYS so
  # rather than passing in silence. verb.sh: "--summon means spend IF AND ONLY
  # IF the contract cannot be fulfilled mechanically -- a grant of permission,
  # never an instruction to spend. On an already-mechanized action it costs
  # zero and says so on stderr." This is that case, permanently.
  if [ "$VERB_SUMMON" = 1 ]; then
    printf '%s: consign is mechanized in this verb; --summon buys nothing here and nothing was spent.\n' \
      "$VERB_NAME" >&2
  fi

  # Run it in the foreground, output unswallowed: the impl reports each
  # DEPOSITED path and what is now safe to remove, and that report is the
  # caller's whole basis for deleting an original. Capturing it to inspect the
  # exit code first is how it went missing.
  local rc
  bash "$impl" "$VAULT" "$@"; rc=$?

  case $rc in
    0) return 0 ;;
    # The impl has already printed its own named reason on stderr; these
    # translate the code into this verb's vocabulary rather than restating it.
    2) verb_die "consign: the deposit mechanism rejected these arguments" ;;
    5) verb_broke "consign: a note was written and read back with a different body; the deposit did not preserve the document" ;;
    6) verb_blind "consign: the deposit mechanism could not read something it needed" ;;
    # A refusal is not a broken promise, and reporting it as one teaches a
    # caller to distrust the loudest code the vocabulary has. The deposit
    # refused because writing would have destroyed something; say that.
    7) verb_refuse "consign: the deposit was refused rather than overwrite an existing note" ;;
    *) verb_broke "consign: the deposit mechanism exited $rc without a recognised failure" ;;
  esac
}

# ---- dispatch --------------------------------------------------------------
# The subcommand and this verb's own flags are lifted out FIRST, because the
# shared runtime rejects any flag it does not recognise -- passing --briefs
# straight to verb_parse is a usage error rather than the corpus report the
# page promises.
SUB=""
PASS=()      # flags the validator understands
RUNTIME=()   # everything the shared runtime should see
while [ $# -gt 0 ]; do
  case "$1" in
    corpus|consign)
      [ -z "$SUB" ] || verb_die "only one subcommand at a time (already have '$SUB')"
      SUB="$1" ;;
    --briefs|--sources|--coverage|--export|\
    --require-briefs|--require-sources|--require-coverage)
      PASS+=("$1") ;;
    # Lifted out here for the same reason as the flags above: the shared
    # runtime rejects what it does not know, and it must not learn a per-verb
    # flag table to give one verb a knob.
    --vault)   shift; [ $# -gt 0 ] || verb_die "--vault needs a path"; VAULT="$1" ;;
    --vault=*) VAULT="${1#*=}"; [ -n "$VAULT" ] || verb_die "--vault needs a path" ;;
    *) RUNTIME+=("$1") ;;
  esac
  shift
done

verb_parse ${RUNTIME[@]+"${RUNTIME[@]}"}
set -- ${VERB_ARGS[@]+"${VERB_ARGS[@]}"}

# --summon with no subcommand requests no work. Running corpus anyway would be
# an implicit spend in the only place a caller reads for cost: a run that was
# authorised to spend and then quietly did something else instead.
if [ "$VERB_SUMMON" = 1 ] && [ "${SUB:-corpus}" = "corpus" ]; then
  verb_die "corpus never spends, so --summon requests nothing here. Only consign can spend."
fi

case "${SUB:-corpus}" in
  consign)
    [ ${#PASS[@]} -eq 0 ] \
      || verb_die "consign: does not take ${PASS[0]}; that is a corpus flag"
    do_consign "$@"
    ;;
  corpus)
    [ $# -eq 0 ] || verb_die "corpus: unknown argument: $1"
    do_corpus ${PASS[@]+"${PASS[@]}"}
    ;;
esac
