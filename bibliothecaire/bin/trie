#!/usr/bin/env bash
# trie -- put the morning's accounts in the order a missed message costs most
#
# Self-contained. This is a rewrite of the Python that used to live on
# secretaire's main branch (triage.py), not a wrapper around it: nothing here
# execs another program, so the branch stands alone and `man trie` describes
# the whole of it.
#
# MOVED HERE 2026-08-02, from secretaire's bashified branch, where it was
# called `range`. secretaire is a product, not a utility -- its milestone names
# an event outside the computer -- and a verb is a utility's finished form
# (WAITING-ROOM.md). Its bashified branch is retired to the tag
# `parked/bashified`; this verb is the part worth keeping, so it moved rather
# than died.
#
# TWO THINGS ABOUT THE NAME, because the record would otherwise read as a
# reversal. `trie` was retired INTO `range` on 2026-07-31 -- but the objection
# was to the SUMMARY, "sort the mail *and* decide what deserves an answer",
# whose "and" bound a table sort to a thing needing eight mailboxes. That
# summary does not come back; the one-clause summary above is `range`'s and it
# stands. Only the name returns, because `range` is bibliothecaire's own verb
# (shelve, catalogue and retrieve the ecosystem's texts) and one name cannot
# mean two things on one PATH. The refusal stays refused -- see CONTRACT.md.
#
# The domain is one tracked file: the hand-filled account inventory. No
# credential, no mailbox, no network. That is a refusal, not an omission --
# granting an unattended program access to real email accounts is past this
# project's autonomy bar and is stated as such in CONTRACT.md.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=trie
VERB_SUMMARY="put the morning's accounts in the order a missed message costs most"
VERB_USAGE="trie [--markdown] [--json] [-q|--quiet]"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

# Read from ONE place. The inventory is the only input the contract names.
INVENTORY="$SELF/ACCOUNTS.md"

# --markdown is this verb's own flag, so it is pulled out before the shared
# grammar sees it: verb_parse rejects unknown flags, and it must keep doing so.
MARKDOWN=0
args=()
for a in "$@"; do
  case "$a" in
    --markdown) MARKDOWN=1 ;;
    *) args+=("$a") ;;
  esac
done
verb_parse "${args[@]+"${args[@]}"}"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"
[ $# -eq 0 ] || verb_die "takes no argument, only flags  (try --help)"

[ -r "$INVENTORY" ] || verb_blind "cannot read the inventory: $INVENTORY"

# Parse the first markdown table whose rows carry an address. Ranked rows sort
# on stakes then address, so two runs over an unchanged inventory agree.
#
# Output of this pass is one TSV line per row: rank<TAB>address<TAB>purpose
# <TAB>stakes<TAB>pain, with rank 9 for a row that carries no stakes value.
rows="$(awk -F'|' '
  /^[[:space:]]*\|/ {
    n = 0; for (i = 2; i < NF; i++) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", $i); c[++n] = $i }
    if (n < 6) next
    if (c[1] == "" || c[1] == "address") next
    if (c[1] ~ /^-+$/) next
    s = tolower(c[5])
    r = (s == "high") ? 0 : (s == "medium") ? 1 : (s == "low") ? 2 : 9
    printf "%d\t%s\t%s\t%s\t%s\n", r, c[1], c[3], s, c[6]
  }
' "$INVENTORY")"

ranked="$(printf '%s\n' "$rows" | awk -F'\t' '$1 != 9' | sort -t$'\t' -k1,1n -k2,2)"
unranked="$(printf '%s\n' "$rows" | awk -F'\t' '$1 == 9')"
[ -n "$rows" ] || { ranked=""; unranked=""; }

n_addr="$(printf '%s' "$rows" | grep -c . || true)"
n_rank="$(printf '%s' "$ranked" | grep -c . || true)"

# An empty list reads as "there is nothing to open". That is a different fact
# from "the ranking column is blank", so this is BLIND and never exit 0.
[ "$n_rank" -gt 0 ] || verb_blind \
  "no account in $(basename "$INVENTORY") carries a stakes value ($n_addr row$([ "$n_addr" = 1 ] || echo s) with an address, 0 ranked)"

if [ "$VERB_JSON" = 1 ]; then
  printf '[\n'
  i=0
  esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
  while IFS=$'\t' read -r r addr purpose stakes pain; do
    [ -n "$addr" ] || continue
    i=$((i + 1))
    [ "$i" = 1 ] || printf ',\n'
    printf '  {"order": %d, "address": "%s", "stakes": "%s", "purpose": "%s", "pain": "%s"}' \
      "$i" "$(esc "$addr")" "$(esc "$stakes")" "$(esc "$purpose")" "$(esc "$pain")"
  done <<< "$ranked"
  while IFS=$'\t' read -r r addr purpose stakes pain; do
    [ -n "$addr" ] || continue
    printf ',\n  {"order": null, "address": "%s", "stakes": null, "purpose": "%s", "pain": "%s"}' \
      "$(esc "$addr")" "$(esc "$purpose")" "$(esc "$pain")"
  done <<< "$unranked"
  printf '\n]\n'
  exit 0
fi

if [ "$VERB_QUIET" != 1 ]; then
  if [ "$MARKDOWN" = 1 ]; then printf '# Morning triage order\n'; else printf 'Morning triage order:\n'; fi
fi

i=0
while IFS=$'\t' read -r r addr purpose stakes pain; do
  [ -n "$addr" ] || continue
  i=$((i + 1))
  line="$i. $addr [$stakes] — ${purpose:-(purpose?)}"
  [ -n "$pain" ] && line="$line — watch for: $pain"
  printf '%s\n' "$line"
done <<< "$ranked"

# Unranked rows are printed, never dropped: dropping them silently reports a
# smaller inventory than the one on disk.
while IFS=$'\t' read -r r addr purpose stakes pain; do
  [ -n "$addr" ] || continue
  printf '?. %s — no stakes value, unranked (fill it in)\n' "$addr"
done <<< "$unranked"
