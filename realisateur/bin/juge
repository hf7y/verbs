#!/usr/bin/env bash
# juge -- perceive this system's state and judge what matters
#
# A plain shell utility. It costs nothing to run and reaches no paid service
# except where a subcommand explicitly declares a summon.
#
# The subcommand table below was DISCOVERED from tooling that actually exists
# in this tree, not invented. A subcommand backed by a script execs it. One
# the contract names but has nothing behind it reports GAP (exit 4) rather
# than pretending, because an exit-0 no-op is the worst failure available.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=juge
VERB_SUMMARY="perceive this system's state and judge what matters"
VERB_USAGE="juge <subcommand> [args...]"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

# Where the legacy implementation lives, for subcommands that exec it. Read
# from ONE place; never retyped per subcommand.
LEGACY_ROOT="${JUGE_LEGACY_ROOT:-/home/zach/Documents/Projects/realisateur}"

verb_subcommands() {
  printf '%s\n' \
    'check-project-busy           run bin/check-project-busy.sh' \
    'ecosim-sensor-tick           run bin/ecosim-sensor-tick.sh' \
    'focus-commit                 run bin/focus-commit.sh' \
    'install-shims                run bin/install-shims.sh' \
    'install-silence-audit        run bin/install-silence-audit.sh' \
    'make-bootstrap-branch        run bin/make-bootstrap-branch.sh' \
    'notify-senechal              run bin/notify-senechal.sh' \
    'restamp-discipline           run bin/restamp-discipline.sh' \
    'session-marker               run bin/session-marker.sh' \
    'weight-audit                 run bin/weight-audit.sh' \
    'inject-suggestions           run fable-like/inject-suggestions.sh' \
    ''
}

# A leading flag is a flag, not a subcommand. Without this arm `--json`,
# `--quiet` and `--version` reach the subcommand table, exit 2 as "unknown
# subcommand", and contradict this verb's own `--help`, which offers all
# three. The generator's template shipped without the arm that `bin/bashify`
# had already grown for itself.
case "${1:-}" in
  -*) cmd=list ;;
  *)  cmd="${1:-}"; [ $# -gt 0 ] && shift ;;
esac
verb_parse "$@"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"

case "$cmd" in
  ''|list)
    printf '%s -- %s\n\n' "$VERB_NAME" "$VERB_SUMMARY"
    printf 'subcommands (discovered from real tooling):\n'
    verb_subcommands | sed '/^$/d' | sed 's/^/  /'
    printf '\n(`%s --help` for flags, `man %s` for the contract)\n' "$VERB_NAME" "$VERB_NAME"
    ;;
  help|--help|-h) verb_usage ;;
  check-project-busy)
    [ -x "$LEGACY_ROOT/bin/check-project-busy.sh" ] || verb_gap 'check-project-busy: bin/check-project-busy.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/check-project-busy.sh" "$@" ;;
  ecosim-sensor-tick)
    [ -x "$LEGACY_ROOT/bin/ecosim-sensor-tick.sh" ] || verb_gap 'ecosim-sensor-tick: bin/ecosim-sensor-tick.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/ecosim-sensor-tick.sh" "$@" ;;
  focus-commit)
    [ -x "$LEGACY_ROOT/bin/focus-commit.sh" ] || verb_gap 'focus-commit: bin/focus-commit.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/focus-commit.sh" "$@" ;;
  install-shims)
    [ -x "$LEGACY_ROOT/bin/install-shims.sh" ] || verb_gap 'install-shims: bin/install-shims.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/install-shims.sh" "$@" ;;
  install-silence-audit)
    # RETIRED, not broken. The script this pointed at is gone:
    # deleted 2026-08-07 in b3fef3d (#101, "retire three surveys and a false-alarm engine")
    # The verb was never updated, so it has been promising a tool that does
    # not exist -- GAPping identically with or without a checkout, which is
    # why nobody noticed. Kept as an explicit refusal rather than deleted so
    # `juge install-silence-audit` says what happened instead of "unknown subcommand", which
    # reads as a typo and sends the reader hunting a spelling mistake.
    verb_gap 'install-silence-audit: retired -- deleted 2026-08-07 in b3fef3d (#101, "retire three surveys and a false-alarm engine")' ;;
  make-bootstrap-branch)
    [ -x "$LEGACY_ROOT/bin/make-bootstrap-branch.sh" ] || verb_gap 'make-bootstrap-branch: bin/make-bootstrap-branch.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/make-bootstrap-branch.sh" "$@" ;;
  notify-senechal)
    [ -x "$LEGACY_ROOT/bin/notify-senechal.sh" ] || verb_gap 'notify-senechal: bin/notify-senechal.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/notify-senechal.sh" "$@" ;;
  restamp-discipline)
    [ -x "$LEGACY_ROOT/bin/restamp-discipline.sh" ] || verb_gap 'restamp-discipline: bin/restamp-discipline.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/restamp-discipline.sh" "$@" ;;
  session-marker)
    [ -x "$LEGACY_ROOT/bin/session-marker.sh" ] || verb_gap 'session-marker: bin/session-marker.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/session-marker.sh" "$@" ;;
  weight-audit)
    # RETIRED, not broken. The script this pointed at is gone:
    # deleted 2026-08-07 in 69246bc (#95, "two weight writers retired") -- and hf7y/scheduler#55 found the weight column wholly inert anyway
    # The verb was never updated, so it has been promising a tool that does
    # not exist -- GAPping identically with or without a checkout, which is
    # why nobody noticed. Kept as an explicit refusal rather than deleted so
    # `juge weight-audit` says what happened instead of "unknown subcommand", which
    # reads as a typo and sends the reader hunting a spelling mistake.
    verb_gap 'weight-audit: retired -- deleted 2026-08-07 in 69246bc (#95, "two weight writers retired") -- and hf7y/scheduler#55 found the weight column wholly inert anyway' ;;
  inject-suggestions)
    # RETIRED, not broken. The script this pointed at is gone:
    # deleted 2026-08-08 in 7984dfa (#119, "retire three dead subtrees to the vault")
    # The verb was never updated, so it has been promising a tool that does
    # not exist -- GAPping identically with or without a checkout, which is
    # why nobody noticed. Kept as an explicit refusal rather than deleted so
    # `juge inject-suggestions` says what happened instead of "unknown subcommand", which
    # reads as a typo and sends the reader hunting a spelling mistake.
    verb_gap 'inject-suggestions: retired -- deleted 2026-08-08 in 7984dfa (#119, "retire three dead subtrees to the vault")' ;;
  *) verb_die "unknown subcommand: $cmd  (try: $VERB_NAME list)" ;;
esac
