#!/usr/bin/env bash
# arpente -- survey the ecosystem and read its state
#
# A plain shell utility. It costs nothing to run and reaches no paid service.
# Parted off from the monolith verb 2026-07-30 (one noun, many verbs): this
# verb owns one coherent domain. A subcommand backed by a script execs it; one
# with nothing behind it reports GAP (exit 4), never an exit-0 no-op.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=arpente
VERB_SUMMARY="survey the ecosystem and read its state"
VERB_USAGE="arpente <subcommand> [args...]"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

LEGACY_ROOT="${ARPENTE_LEGACY_ROOT:-/home/zach/Documents/Projects/realisateur}"

verb_subcommands() {
  printf '%s\n' \
    'ecosystem-survey             survey every registered project' \
    'steward-survey               who is stewarding each project' \
    'milestone-audit              per-project stability-milestone progress' \
    'incubation-audit             which scaffolded projects have graduated' \
    'precipitation-scan           recurring terms clustering across FOCUS files' \
    'liveness-audit               is a registered project actually alive' \
    ''
}

# A leading flag is a flag, not a subcommand. Without this arm `--json`,
# `--quiet` and `--version` reach the subcommand table, exit 2 as "unknown
# subcommand", and contradict this verb's own `--help`, which offers all
# three. The generator's template shipped without the arm that `bin/bashify`
# had already grown for itself.
case "${1:-}" in
  -*) cmd=list ;;
  *)  cmd="${1:-}"; [ $# -gt 0 ] && shift || true ;;
esac
verb_parse "$@"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"

case "$cmd" in
  ''|list)
    printf '%s -- %s\n\n' "$VERB_NAME" "$VERB_SUMMARY"
    printf 'subcommands:\n'
    verb_subcommands | sed '/^$/d' | sed 's/^/  /'
    printf '\n(`man %s` for the contract)\n' "$VERB_NAME"
    ;;
  help|--help|-h) verb_usage ;;
  ecosystem-survey)
    # RETIRED, not broken. The script this arm pointed at is gone:
    # bin/ecosystem-survey.sh, deleted 2026-08-07 in b3fef3d (#101, "retire three surveys and a false-alarm engine")
    # The verb was never updated, so this subcommand has been promising a
    # tool that does not exist -- it GAPped identically with or without a
    # checkout, which is why nobody noticed. Kept as an explicit refusal
    # rather than deleted so `ecosystem-survey` says what happened instead of
    # "unknown subcommand", which reads as a typo.
    verb_gap 'ecosystem-survey: retired -- bin/ecosystem-survey.sh, deleted 2026-08-07 in b3fef3d (#101, "retire three surveys and a false-alarm engine")' ;;
  steward-survey)
    # RETIRED, not broken. The script this arm pointed at is gone:
    # bin/steward-survey.sh, deleted 2026-08-07 in b3fef3d (#101)
    # The verb was never updated, so this subcommand has been promising a
    # tool that does not exist -- it GAPped identically with or without a
    # checkout, which is why nobody noticed. Kept as an explicit refusal
    # rather than deleted so `steward-survey` says what happened instead of
    # "unknown subcommand", which reads as a typo.
    verb_gap 'steward-survey: retired -- bin/steward-survey.sh, deleted 2026-08-07 in b3fef3d (#101)' ;;
  milestone-audit)
    # RETIRED, not broken. The script this arm pointed at is gone:
    # bin/milestone-audit.sh, deleted 2026-08-07 in b3fef3d (#101)
    # The verb was never updated, so this subcommand has been promising a
    # tool that does not exist -- it GAPped identically with or without a
    # checkout, which is why nobody noticed. Kept as an explicit refusal
    # rather than deleted so `milestone-audit` says what happened instead of
    # "unknown subcommand", which reads as a typo.
    verb_gap 'milestone-audit: retired -- bin/milestone-audit.sh, deleted 2026-08-07 in b3fef3d (#101)' ;;
  incubation-audit)
    # RETIRED, not broken. The script this arm pointed at is gone:
    # bin/incubation-audit.sh, deleted 2026-08-07 in 69246bc (#95)
    # The verb was never updated, so this subcommand has been promising a
    # tool that does not exist -- it GAPped identically with or without a
    # checkout, which is why nobody noticed. Kept as an explicit refusal
    # rather than deleted so `incubation-audit` says what happened instead of
    # "unknown subcommand", which reads as a typo.
    verb_gap 'incubation-audit: retired -- bin/incubation-audit.sh, deleted 2026-08-07 in 69246bc (#95)' ;;
  precipitation-scan)
    # CARRIED: travels on this branch, so $SELF finds it with no checkout.
    [ -x "$SELF/bin/precipitation-scan.sh" ] || verb_gap 'precipitation-scan: missing from this BUILD (not from a checkout -- this verb no longer needs one)'
    exec "$SELF/bin/precipitation-scan.sh" "$@" ;;
  liveness-audit)
    # RETIRED, not broken. The script this arm pointed at is gone:
    # never existed under bin/ in this repo at all
    # The verb was never updated, so this subcommand has been promising a
    # tool that does not exist -- it GAPped identically with or without a
    # checkout, which is why nobody noticed. Kept as an explicit refusal
    # rather than deleted so `liveness-audit` says what happened instead of
    # "unknown subcommand", which reads as a typo.
    verb_gap 'liveness-audit: retired -- never existed under bin/ in this repo at all' ;;
  *) verb_gap "unknown subcommand: $cmd (try \`list\`)" ;;
esac
