#!/usr/bin/env bash
# rapporte -- render the night's account of what this ecosystem did
#
# Coined 2026-08-01 by `bashify coin` onto scheduler's bashified branch,
# beside `dose`, `arme` and `relis`. One noun, many verbs.
#
# THE SEAM. `dose` discovered 25 subcommands from real tooling and welded four
# domains into one table. These four share what nothing else in it does: each
# takes work that already happened and renders an account of it for a reader.
# They dispatch nothing, gate nothing, and check no file's shape. Reporting is
# its own domain and this is where it was cut out.
#
# MORNING-REPORT IS DELIBERATELY ABSENT. `dose` fronts bin/morning-report.sh,
# whose own second line reads "DEPRECATED (2026-07-20) -- superseded by
# bin/scheduler". A generated subcommand table cannot read a deprecation
# notice, so the weld presented a retired script as a live capability. Coining
# by hand is where that gets noticed; the script is left where it is and is
# simply not offered here.
#
# IT WRAPS, IT DOES NOT REIMPLEMENT. Every subcommand execs the existing
# script in scheduler's own bin/, unchanged.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=rapporte
VERB_SUMMARY="render the night's account of what this ecosystem did"
VERB_USAGE="rapporte <list|publish|facts|verdict|services> [args...]"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

LEGACY_ROOT="${RAPPORTE_LEGACY_ROOT:-$HOME/Documents/Projects/scheduler}"

# name -> the script it fronts. ONE place; never retyped per subcommand.
_impl() {
  case "$1" in
    publish)  echo "bin/publish-report.sh" ;;
    facts)    echo "bin/unprinted-facts.sh" ;;
    verdict)  echo "bin/verdict.sh" ;;
    services) echo "bin/build-services-view.sh" ;;
  esac
}

verb_subcommands() {
  printf '%s\n' \
    'list' \
    'publish' \
    'facts' \
    'verdict' \
    'services' \
    ''
}

# A leading flag is a flag, not a subcommand.
case "${1:-}" in
  -*) cmd=list ;;
  *)  cmd="${1:-}"; [ $# -gt 0 ] && shift ;;
esac
verb_parse "$@"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"

case "$cmd" in
  ''|list)
    # The subcommands, bare, one per line: the machine surface. `bashify
    # check` reads the last field of every line printed here, so a header or
    # a trailing hint would donate its final word to this list.
    verb_subcommands | sed '/^$/d'
    ;;

  help|--help|-h) verb_usage ;;

  publish|facts|verdict|services)
    rel="$(_impl "$cmd")"
    [ -x "$LEGACY_ROOT/$rel" ] \
      || verb_gap "$cmd: $rel is not executable or not present under $LEGACY_ROOT"
    exec "$LEGACY_ROOT/$rel" "$@"
    ;;

  *) verb_die "unknown subcommand: $cmd  (try: $VERB_NAME list)" ;;
esac
