#!/usr/bin/env bash
# relis -- proofread the files this ecosystem writes about itself
#
# Coined 2026-08-01 by `bashify coin` onto scheduler's bashified branch,
# beside `dose` and `arme`. One noun, many verbs.
#
# THE SEAM. `dose` discovered 25 subcommands from real tooling and welded four
# domains into one table: dispatch, reporting, usage-gating, and these five
# lints. A caller reaching for `questions-lint` and a caller reaching for
# `sync-crontab` want different things for different reasons and pipe the
# results somewhere different. RESEARCH-VERB-ECOSYSTEM-20260730.md named the
# seams; this cuts the one with the clearest edge.
#
# What these five share, and nothing else in `dose` does: each reads a file
# this ecosystem writes about ITSELF -- a registry conf, a QUESTIONS.md, a
# BLOCKERS.md, a reply, a rotation -- and reports where the file no longer
# holds the shape its own consumers assume. None of them dispatch anything.
# None spend. They are proofreading, which is why the verb is `relis`.
#
# IT WRAPS, IT DOES NOT REIMPLEMENT. Every check below is an existing script
# in scheduler's own bin/, unchanged. A wrapper that quietly reimplements the
# thing it fronts is two implementations that drift; this one execs.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=relis
VERB_SUMMARY="proofread the files this ecosystem writes about itself"
VERB_USAGE="relis <list|all|blockers|questions|replies|rotation|witness>"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

LEGACY_ROOT="${RELIS_LEGACY_ROOT:-/home/zach/Documents/Projects/scheduler}"

# name -> the script it fronts. ONE place; never retyped per subcommand.
_impl() {
  case "$1" in
    blockers)  echo "bin/blockers-freshness-check.sh" ;;
    questions) echo "bin/questions-lint.sh" ;;
    replies)   echo "bin/lint-replies.sh" ;;
    rotation)  echo "bin/rotation-lint.sh" ;;
    witness)   echo "bin/check-witness-lint.sh" ;;
  esac
}

verb_subcommands() {
  printf '%s\n' \
    'list' \
    'all' \
    'blockers' \
    'questions' \
    'replies' \
    'rotation' \
    'witness' \
    ''
}

# A leading flag is a flag, not a subcommand.
case "${1:-}" in
  -*) cmd=list ;;
  *)  cmd="${1:-}"; [ $# -gt 0 ] && shift ;;
esac
verb_parse "$@"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"

_run_one() {
  local name="$1"; shift
  local rel; rel="$(_impl "$name")"
  [ -n "$rel" ] || verb_die "unknown check: $name  (try: $VERB_NAME list)"
  [ -x "$LEGACY_ROOT/$rel" ] \
    || verb_gap "$name: $rel is not executable or not present under $LEGACY_ROOT"
  "$LEGACY_ROOT/$rel" "$@"; rc=$?
  # FINDINGS ARE 7, ALWAYS. The wrapped lints return 1 and 2 of their own, and
  # 2 already means "the caller is wrong" here -- so passing a status through
  # unchanged makes a file that lost its shape indistinguishable from a
  # mistyped argument. 1 is reserved by the shared vocabulary (bashify check
  # says so, and said so about this page). 7 is where a finding ABOUT THE
  # SUBJECT belongs: the same code `bashify check` uses when the page it
  # tested failed a row. The subject failing is not the tool failing.
  [ "$rc" = 0 ] && return 0
  return 7
}

case "$cmd" in
  ''|list)
    # The subcommands, bare, one per line: the machine surface. `bashify
    # check` reads the last field of every line printed here, so anything
    # else -- a header, a hint -- donates its final word to this list.
    verb_subcommands | sed '/^$/d'
    ;;

  help|--help|-h) verb_usage ;;

  all)
    # Every check, and the WORST outcome wins rather than the last. A runner
    # that returns its final command's status reports clean whenever the
    # cleanest check happens to run last, which is the exit-0-no-op this
    # ecosystem records more than any other defect.
    worst=0; ran=0; failed=""; gapped=0
    for name in blockers questions replies rotation witness; do
      rel="$(_impl "$name")"
      if [ ! -x "$LEGACY_ROOT/$rel" ]; then
        printf 'relis: SKIP %-10s %s is not present\n' "$name" "$rel" >&2
        # A check that could not run is a GAP (4). It must not be overwritten
        # by a later finding: a pass on the four that ran does not establish
        # the fifth. Findings raise to 7 only from below 7, and GAP is
        # reported alongside rather than replaced -- see the gap flag.
        gapped=1
        continue
      fi
      printf '== %s ==\n' "$name"
      "$LEGACY_ROOT/$rel"; rc=$?
      ran=$((ran + 1))
      # Same normalisation as _run_one, for the same reason.
      # Findings never LOWER the verdict. Written as a plain assignment first,
      # which silently demoted a GAP(4) to 1 as soon as any later check had a
      # finding -- the missing check vanishing behind a check that ran.
      [ "$rc" = 0 ] || { [ "$worst" -lt 7 ] && worst=7; failed="$failed $name"; }
    done
    printf '\nrelis: %s check(s) ran' "$ran"
    [ -n "$failed" ] && printf '; not clean:%s' "$failed"
    [ "$gapped" = 1 ] && printf 'relis: at least one check could not run; GAP outranks findings\n' >&2
    printf '\n'
    [ "$gapped" = 1 ] && exit 4
    exit "$worst"
    ;;

  blockers|questions|replies|rotation|witness)
    _run_one "$cmd" "$@"
    ;;

  *) verb_die "unknown subcommand: $cmd  (try: $VERB_NAME list)" ;;
esac
