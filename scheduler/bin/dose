#!/usr/bin/env bash
# dose -- apportion this ecosystem's scheduled work
#
# A plain shell utility. It costs nothing to run and reaches no paid service.
#
# ONE FRONT DOOR: `dose <project> [--check|--apply]`. hf7y/scheduler#296 --
# a 25-entry subcommand passthrough table used to live here, one arm per
# script discovered in the legacy tree. Measured 2026-08-28: zero of the 25
# had ever been invoked as `dose <sub>` -- no crontab, no runtime script, no
# account, on any host. It was scheduler/bin wearing a verb's clothes. Cut
# entire, per Zach's decision on realisateur's `/ideate`: no subcommand was
# spared on the strength of "a human might type it occasionally" (that
# argument was raised for morning-report/token-usage specifically and
# declined). If either is missed, it comes back as its own front door on its
# own merits, not as a survivor of a namespace nobody used.
#
# Installed host-wide in /usr/local/bin anyway: not because every account
# needs it (none call it), but because the operator needs it reachable over
# ssh, and `--now` execs itself over ssh where `$HOME` is not on PATH.
#
# bin/freeze-check.sh, bin/tempo.sh, bin/usage-paced-runner.sh and
# bin/verdict.sh still travel on this branch alongside bin/dose-project.sh --
# that carry is independent of the subcommand table this cut removes (see
# hf7y/scheduler#350: a no-checkout copy of the dispatch tick has uses this
# CLI never provided). Only the CLI arms that pointed at them are gone.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=dose
VERB_SUMMARY="apportion this ecosystem's scheduled work"
VERB_USAGE="dose <project> [--check|--apply|--now]"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

# ---------------------------------------------------------------------------
# THE PROJECT FORM -- `dose <project> [--check|--apply]`, and now the ONLY
# form this verb has.
#
# Zach, 2026-08-11: "I should be able to ssh zach@monkey and run `dose ecosim`
# and the newest ecosim self-installs, updates, starts clearing issues, setting
# up its rate should be part of the bootstrap process. it checks one source of
# truth. and that's maintained by me."
#
# WHY IT IS HANDLED HERE AND NOT AS A `case` ARM BELOW. `verb_parse` is the
# shared runtime's flag parser and it REFUSES a flag it does not know. It knows
# --json/--quiet/--version/--help. It does not know --check/--apply/--now,
# which belong to bin/dose-project.sh. So resolving the project form has to
# happen BEFORE the flag parser, or `dose ecosim --check` dies at `unknown
# flag: --check` before dispatch. Found by running it, 2026-08-11.
#
# WHY $SELF AND NOT A CHECKOUT. dose-project.sh travels ON this branch, so the
# verb build carries it beside this file and $SELF finds it with no checkout
# anywhere -- hf7y/scheduler#80 has it read the roster from GitHub for the
# same reason, precisely because a local clone is stale or absent.
#
# A leading flag is a flag, not a project name (`dose --help`, `dose
# --version`) -- falls through to verb_parse below.
case "${1:-}" in
  -*) cmd="" ;;
  *)  cmd="${1:-}" ;;
esac

if [ -n "$cmd" ] && [ "$cmd" != list ] && [ "$cmd" != help ] \
   && [ -x "$SELF/bin/dose-project.sh" ]; then
  exec "$SELF/bin/dose-project.sh" "$@"
fi

verb_parse "$@"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"

case "${1:-}" in
  ''|list)
    printf '%s -- %s\n\n' "$VERB_NAME" "$VERB_SUMMARY"
    printf 'usage:\n'
    printf '  %-28s %s\n' '<project> [--check|--apply]' \
      'converge this host to schedule/ROSTER (--check writes nothing)'
    printf '\n(`%s --help` for flags, `man %s` for the contract)\n' "$VERB_NAME" "$VERB_NAME"
    ;;
  help) verb_usage ;;
  *)
    # The project form is dispatched ABOVE, before verb_parse. Reaching here
    # with a non-empty, non-list, non-help argument means bin/dose-project.sh
    # is missing from this build -- there is no other subcommand left to be.
    verb_die "bin/dose-project.sh is missing from this BUILD (try: $VERB_NAME list)" ;;
esac
