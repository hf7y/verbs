#!/usr/bin/env bash
# jauge -- measure what the ecosystem has spent against what it may
#
# Coined 2026-08-01 by `bashify coin` onto scheduler's bashified branch,
# beside `dose`, `arme`, `relis` and `rapporte`. One noun, many verbs.
#
# THE SEAM, and it is finer than the domain list suggested. The usage domain
# looked like three scripts. Two of them measure and decide -- `token-usage`
# reads real burn out of the logs, `usage-gate` is the pacing brain's sensor
# and its verdict. The third, `usage-paced-runner`, is the pacing DISPATCHER:
# it acts on that verdict by running jobs. Measuring and dispatching are the
# division this whole family is built on, so the runner stays with `dose` and
# only the instruments come here.
#
# A verb that both measures the quota and spends it would be the same shape
# this ecosystem refuses everywhere else.
#
# IT WRAPS, IT DOES NOT REIMPLEMENT. Both subcommands exec the existing script
# in scheduler's own bin/, unchanged.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=jauge
VERB_SUMMARY="measure what the ecosystem has spent against what it may"
VERB_USAGE="jauge <list|burn|gate> [args...]"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

LEGACY_ROOT="${JAUGE_LEGACY_ROOT:-$HOME/Documents/Projects/scheduler}"

_impl() {
  case "$1" in
    burn) echo "bin/token-usage.sh" ;;
    gate) echo "bin/usage-gate.sh" ;;
  esac
}

verb_subcommands() {
  printf '%s\n' \
    'list' \
    'burn' \
    'gate' \
    ''
}

case "${1:-}" in
  -*) cmd=list ;;
  *)  cmd="${1:-}"; [ $# -gt 0 ] && shift ;;
esac
verb_parse "$@"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"

case "$cmd" in
  ''|list)
    # Bare names, one per line: the machine surface.
    verb_subcommands | sed '/^$/d'
    ;;

  help|--help|-h) verb_usage ;;

  burn|gate)
    rel="$(_impl "$cmd")"
    [ -x "$LEGACY_ROOT/$rel" ] \
      || verb_gap "$cmd: $rel is not executable or not present under $LEGACY_ROOT"
    exec "$LEGACY_ROOT/$rel" "$@"
    ;;

  *) verb_die "unknown subcommand: $cmd  (try: $VERB_NAME list)" ;;
esac
