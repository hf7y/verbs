#!/usr/bin/env bash
# arme -- arm a recurring job that never spends
#
# Coined 2026-08-01 by `bashify coin` onto scheduler's bashified branch,
# beside `dose`. One noun, many verbs: `dose` apportions AGENT work, this
# arms the maintenance that is not agent work at all.
#
# WHY A SECOND VERB RATHER THAN A DOSE SUBCOMMAND.
#
# Every job kind `dose` can emit -- RUNNER, SWEEP, BATCH -- is an agent run or
# the dispatch of one, and every one is gated by USAGE_CEILING. A monitor
# wired through any of them inherits that gate and therefore STOPS REPORTING
# EXACTLY WHEN QUOTA IS EXHAUSTED, which is when its report matters most.
#
#     "QUOTA EXHAUSTED" AND "NOTHING TO REPORT" ARE TWO WORLD-STATES,
#     AND A USAGE-GATED MONITOR EMITS THE SAME SILENCE FOR BOTH.
#
# That is the two-states-one-symbol collapse this ecosystem was built to
# catch, occurring at the scheduling layer rather than the sensor layer. The
# separation is the fix; a flag on an existing kind would not be, because the
# gate lives in the runner those kinds are dispatched by.
#
# IT OWNS ITS OWN CRONTAB BLOCK, with its own markers. `sync-crontab.sh`
# rewrites only the text between the `scheduler-managed` markers and reads a
# foreign account's crontab before writing it, precisely so unmanaged lines
# are not silently discarded. Two blocks, two owners, two contracts -- and
# neither generator can quietly eat the other's work.
#
# This verb DOES write the crontab, where `transplante` refuses to. That is
# not inconsistency: the crontab in this ecosystem belongs to scheduler, and
# this verb ships inside scheduler. transplante refuses because it is not the
# owner. A tool may write what it owns.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=arme
VERB_SUMMARY="arm a recurring job that never spends"
VERB_USAGE="arme <list|jobs|check|plan|apply>"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

LEGACY_ROOT="${ARME_LEGACY_ROOT:-/home/zach/Documents/Projects/scheduler}"
CONF="$LEGACY_ROOT/schedule/_monitor.conf"
HOSTCONF="$LEGACY_ROOT/schedule/_monitor.$(hostname -s 2>/dev/null).conf"

MARK_BEGIN="# >>> arme-managed (non-agent monitors -- edit schedule/_monitor.conf, then \`arme apply\`) >>>"
MARK_END="# <<< arme-managed <<<"

verb_subcommands() {
  printf '%s\n' \
    'list' \
    'jobs' \
    'check' \
    'plan' \
    'apply' \
    ''
}

# A leading flag is a flag, not a subcommand.
case "${1:-}" in
  -*) cmd=list ;;
  *)  cmd="${1:-}"; [ $# -gt 0 ] && shift ;;
esac
verb_parse "$@"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"

# ---- reading the register --------------------------------------------------
# Line format, matching schedule/_paced.conf's shape rather than inventing a
# second one: name|enabled|cron|command
# A host file of the same name REPLACES an entry with the same name, so one
# host can arm what another does not, on the shared-then-host rule _runner.conf
# and _sweep.conf already use.
_entries() {
  { [ -f "$CONF" ] && cat "$CONF"; [ -f "$HOSTCONF" ] && cat "$HOSTCONF"; } 2>/dev/null \
  | sed 's/#.*//' \
  | awk -F'|' 'NF>=4 {
      gsub(/^[ \t]+|[ \t]+$/,"",$1); if ($1=="") next
      line[$1]=$0; if (!($1 in seen)) { order[++n]=$1; seen[$1]=1 }
    } END { for (i=1;i<=n;i++) print line[order[i]] }'
}

_field() { printf '%s' "$1" | cut -d'|' -f"$2" | sed 's/^[ \t]*//; s/[ \t]*$//'; }

# A five-field cron expression. Nothing clever: this rejects the shapes that
# silently never fire, which is the failure a monitor can least afford.
_valid_cron() {
  # NOGLOB IS LOAD-BEARING. A cron expression is mostly asterisks, and word
  # splitting without `set -f` lets the shell expand them against the working
  # directory: "*/30 * * * *" became however many files happened to be there,
  # and a valid expression was reported as "not five fields". Found 2026-08-01
  # on this verb's first real entry.
  local n
  set -f
  # shellcheck disable=SC2086
  set -- $1
  n=$#
  set +f
  [ "$n" -eq 5 ]
}

# CAN THIS COMMAND SPEND? The contract of this verb is that an armed job never
# does, so the claim is established or REFUSED -- never assumed.
#
# STATIC ANALYSIS CANNOT ESTABLISH THIS, and pretending otherwise was this
# verb's first real defect. Two negative tests passed a job that spends:
# realisateur-nightly-batch-loop.sh names no model runner because it execs
# scheduler-run, and scheduler-run names none either because it resolves its
# engine from $BASH_SOURCE at runtime. A follower chasing literal paths finds
# nothing and reports FREE with full confidence.
#
# So the verdicts are: SPENDS (the INVOCATION asks to spend -- refused, and
# un-attestable), MIXED (the binary can spend but this invocation does not --
# attestable, and WARNED on every check), FREE (an obvious leaf -- readable,
# naming no model runner, handing control to nothing), and UNVERIFIED
# (everything else).
# UNVERIFIED IS NOT A PASS. It is cleared by an ATTESTATION in the register's
# fifth field: a human sentence saying why this job cannot spend. The gate
# then holds a signed claim instead of a guess, and the claim is in git.
_spend_risk() {
  local cmd="$1" bin
  bin="$(printf '%s' "$cmd" | awk '{print $1}')"
  [ -x "$bin" ] || { echo "NOTFOUND"; return; }
  [ -r "$bin" ] || { echo "UNVERIFIED"; return; }
  if ! head -c 2 "$bin" 2>/dev/null | grep -q '#!'; then echo "UNVERIFIED"; return; fi
  # THE INVOCATION, NOT THE BINARY (Zach, 2026-08-01: "c but throw a warning").
  #
  # Judging the binary alone refused a job that provably cannot spend:
  # `garde media run --all-pending` copies and md5-verifies, does not accept
  # --summon, and reaches no model -- but garde's source matches /claude/ in
  # the COMMENT documenting what its --summon flag costs. A tool with one
  # paying subcommand was therefore un-armable for all of its free ones, and
  # the refusal was un-attestable, so the only way out was to keep such jobs
  # outside the register that exists to list them. An unlistable job is worse
  # than a warned one.
  #
  # What is still refused OUTRIGHT, and cannot be attested away: an invocation
  # that itself asks to spend. --summon is the ecosystem's one cost sigil, so
  # its presence in the command line is decisive regardless of what the binary
  # looks like.
  if printf '%s' "$cmd" | grep -qE '(^|[[:space:]])--summon([[:space:]]|$)|\bclaude\b|anthropic'; then
    echo "SPENDS"; return
  fi
  # The binary CAN spend, but this invocation does not ask it to. Not refused,
  # not waved through: MIXED demands the same attestation UNVERIFIED does, and
  # warns on every check so the register never quietly forgets that a paying
  # path exists a flag away.
  if grep -qE '\bclaude\b|anthropic' "$bin" 2>/dev/null; then echo "MIXED"; return; fi
  # Any handing-off of control at all makes this not a leaf: exec, source,
  # command substitution, eval, or a path to another program.
  if grep -qE '(^|[^A-Za-z_])(exec|eval|source)[[:space:]]|^[[:space:]]*\.[[:space:]]|\$\(|`|/home/|/usr/(local/)?bin/' \
       "$bin" 2>/dev/null; then
    echo "UNVERIFIED"; return
  fi
  echo "FREE"
}

case "$cmd" in
  ''|list)
    # THE SUBCOMMANDS, bare, one per line. `bashify check` reads this as the
    # verb's own surface and compares it against the SYNOPSIS, so listing
    # anything else here -- the armed jobs, say -- makes the tool appear to
    # offer subcommands named after the data. That is what `jobs` is for.
    verb_subcommands | sed '/^$/d'
    ;;

  jobs)
    # The armed monitors, bare names, one per line: the machine surface for
    # the register rather than for the verb.
    #
    # The trailing `:` is not decoration. Without it this subcommand's status
    # is whatever the loop's last test happened to be, so listing exited 1 --
    # "something went wrong" -- purely because the final line was blank or the
    # last entry was parked. A status that varies with the data while meaning
    # nothing about success is worse than no status at all, and `bashify check`
    # caught it as an undocumented exit code.
    _entries | while IFS= read -r e; do
      [ -n "$e" ] || continue
      [ "$(_field "$e" 2)" = 1 ] && _field "$e" 1
    done
    :
    ;;

  help|--help|-h) verb_usage ;;

  check)
    [ -f "$CONF" ] || verb_gap "no register at $CONF; nothing is armed and nothing declares it should be"
    n=0; bad=0
    warned=0
    while IFS= read -r e; do
      [ -n "$e" ] || continue
      name="$(_field "$e" 1)"; on="$(_field "$e" 2)"
      cron="$(_field "$e" 3)"; cmdline="$(_field "$e" 4)"
      attest="$(_field "$e" 5)"
      n=$((n + 1))
      [ "$on" = 1 ] || { printf 'PARKED     %-22s enabled=0\n' "$name"; continue; }
      if ! _valid_cron "$cron"; then
        printf 'BADCRON    %-22s %s is not five fields\n' "$name" "$cron"; bad=1; continue
      fi
      case "$(_spend_risk "$cmdline")" in
        NOTFOUND)
          printf 'NOTFOUND   %-22s %s is not executable\n' "$name" "$(printf '%s' "$cmdline" | awk '{print $1}')"; bad=1 ;;
        SPENDS)
          printf 'SPENDS     %-22s the INVOCATION asks to spend (--summon or a model runner) -- this belongs to dose, not arme\n' "$name"; bad=1 ;;
        MIXED)
          # Attested exactly as UNVERIFIED is -- the difference is the warning,
          # which is printed every run rather than once at arming time.
          if [ "${#attest}" -ge 16 ]; then
            printf 'WARN       %-22s %s\n' "$name" "$attest"
            printf '           %-22s the binary CAN spend (%s names a model runner); this invocation does not. Re-read the attestation if either changes.\n' \
              '' "$(printf '%s' "$cmdline" | awk '{print $1}')"
            warned=$((warned + 1))
          else
            printf 'MIXED      %-22s binary can spend but this invocation does not; add a 5th field attesting why\n' "$name"; bad=1
          fi ;;
        UNREADABLE)
          printf 'UNREADABLE %-22s cannot be read, so "never spends" is unverified\n' "$name"; bad=1 ;;
        UNVERIFIED)
          # Cleared only by a stated reason, which is a claim in git rather
          # than a guess in a heuristic. Length is checked so the field cannot
          # be satisfied by a full stop.
          if [ "${#attest}" -ge 16 ]; then
            printf 'ATTESTED   %-22s %s\n' "$name" "$attest"
          else
            printf 'UNVERIFIED %-22s hands off control; add a 5th field attesting why it cannot spend\n' "$name"; bad=1
          fi ;;
        FREE)
          printf 'FREE       %-22s %s\n' "$name" "$cron" ;;
      esac
    done <<EOF
$(_entries)
EOF
    [ "$n" -gt 0 ] || verb_gap "$CONF declares no entries"
    printf '\n'
    if [ "$bad" != 0 ]; then
      printf 'arme: REFUSED: at least one entry cannot be armed as declared.\n'
      printf 'arme: a monitor is armed on a checked claim or not at all.\n'
      exit 7
    fi
    if [ "${warned:-0}" != 0 ]; then
      # Loud on every run, not once at arming time. A tool that gains a paying
      # subcommand later does not re-announce itself, so the register has to.
      printf 'arme: %s entr(y/ies) checked; %s armed on an attestation that its binary CAN spend.\n' "$n" "$warned"
      printf 'arme: those are armed, not refused -- but re-read their 5th field whenever the tool changes.\n'
    else
      printf 'arme: %s entr(y/ies) checked; every armed one is free to run.\n' "$n"
    fi
    ;;

  plan)
    printf '%s\n' "$MARK_BEGIN"
    while IFS= read -r e; do
      [ -n "$e" ] || continue
      [ "$(_field "$e" 2)" = 1 ] || continue
      printf '%s %s # arme:%s:MONITOR (non-agent, never usage-gated)\n' \
        "$(_field "$e" 3)" "$(_field "$e" 4)" "$(_field "$e" 1)"
    done <<EOF
$(_entries)
EOF
    printf '%s\n' "$MARK_END"
    ;;

  apply)
    # Never arm what `check` refuses. The gate runs HERE rather than being
    # left to the caller's discipline, because a caller who skips it is
    # exactly the caller this verb exists to protect.
    if ! "$0" check >/dev/null 2>&1; then
      printf 'arme: REFUSED: `arme check` does not pass; nothing was installed.\n' >&2
      "$0" check >&2
      exit 7
    fi
    block="$("$0" plan)"
    current="$(crontab -l 2>/dev/null)"
    # Replace only our own block. Everything else -- including
    # sync-crontab.sh's scheduler-managed block -- is copied through
    # untouched, which is the same courtesy sync-crontab extends to us.
    rest="$(printf '%s\n' "$current" | awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
      $0==b {skip=1; next} $0==e {skip=0; next} !skip')"
    printf '%s\n%s\n' "$rest" "$block" | sed '/^$/{x;/./d;x}' | crontab -
    rc=$?
    [ "$rc" = 0 ] || verb_broke "crontab refused the new table (exit $rc); nothing changed"
    # `jobs`, not `list`. While list still enumerated the register this read
    # correctly; after the two were split it counted this verb's OWN
    # subcommands and reported "armed 5 monitor(s)" over a single armed job.
    # A count wrong in a reassuring direction is worse than no count.
    printf 'arme: armed %s monitor(s).\n' "$("$0" jobs | grep -c .)"
    printf 'arme: the scheduler-managed block was copied through untouched.\n'
    printf 'arme: verify with `crontab -l`, and tell the estate with notify-senechal.\n'
    ;;

  *) verb_die "unknown subcommand: $cmd  (try: $VERB_NAME list)" ;;
esac
