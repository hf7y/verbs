#!/usr/bin/env bash
# sonde -- probe the contracted sensors of this ecosystem
#
# This verb is a FRONT DOOR with a TRANSLATING EXIT LAYER, which is the part
# that is not a wrapper. The tooling it fronts speaks the Monitoring Plugins
# dialect (0 OK / 1 WARN / 2 CRIT / 3 BLIND). This ecosystem's vocabulary
# gives 3 a different meaning entirely: needs-summon. A pass-through wrapper
# would therefore report this project's own BLIND -- its whole thesis -- as
# "this needs a summon", which is a wrong answer at zero cost, the failure
# signature Law 4 names. So every legacy code is translated, and BLIND lands
# on 6 where the rest of the ecosystem reads it.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=sonde
VERB_SUMMARY="probe the contracted sensors of this ecosystem"
VERB_USAGE="sonde <list|contract|run|sweep|selftest> [args...]"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

# Read from ONE place; never retyped per subcommand.
#
# Until 2026-08-05 this defaulted to /home/zach/Documents/Projects/ecosim -- a
# hardcoded dev clone, on a machine this build may not even be running on. The
# branch has since been given the tooling it fronts, so the default is now
# THIS TREE: a build carries what it promises, and nothing reaches back into
# ~/Documents/Projects. SONDE_LEGACY_ROOT still overrides, for running the
# verb against a working clone during development.
LEGACY_ROOT="${SONDE_LEGACY_ROOT:-$SELF}"

# The tooling ARCHIVES (`ecosim-sensor run --log`, migration-watch's events
# log). $SELF is an immutable build directory whose contents the next
# `install-verb-build.sh --apply` replaces, so an archive written there is a
# record that dies with the build. Point the writers at a durable state dir
# instead -- declared here once, read from ONE place, and overridable.
export ECOSIM_STATE_DIR="${ECOSIM_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ecosim}"

# ---------------------------------------------------------------- translate
# The legacy dialect -> this ecosystem's vocabulary. Documented in sonde(1)
# EXIT STATUS; 8 and 9 are project-specific codes above 6, which the naming
# convention allows precisely so that severity is not flattened into "broke".
# 7 is NOT used here: CONTRACT.md already spends it on REFUSED, and quietly
# redefining a code the contract has already promised is the same defect as
# any other symbol collision.
sonde_run_translated() {
  local what="$1"; shift
  local rc=0
  "$@" || rc=$?
  case "$rc" in
    0) return 0 ;;
    1) printf '%s: WARN: %s observed a hazard symbol\n' "$VERB_NAME" "$what" >&2; exit 8 ;;
    2) printf '%s: CRIT: %s observed a critical symbol\n' "$VERB_NAME" "$what" >&2; exit 9 ;;
    3) verb_blind "$what could not read part of its domain" ;;
    *) verb_broke "$what exited $rc, which its own contract does not define" ;;
  esac
}

sonde_need() {
  [ -x "$LEGACY_ROOT/$1" ] || verb_gap "$2: $LEGACY_ROOT/$1 is not executable or not present"
}

verb_subcommands() {
  printf '%s\n' \
    'list                         the contracted sensors and their symbol counts' \
    'contract [<sensor>]          the declared alphabet and domain of a sensor' \
    'run [<sensor>...]            probe now; one line per reading, status first' \
    'sweep                        one aggregated pass of every instrument' \
    'selftest                     the coverage gate over every declared symbol' \
    ''
}

# A leading flag is a flag, not a subcommand -- but a flag can also come
# AFTER the subcommand (`sonde run --json`, not just `sonde --json run`),
# and the two must not be confused. Scan for the first non-flag token as the
# subcommand, wherever it falls, and hand every flag -- before or after it --
# to verb_parse untouched. Bug this replaces: defaulting to `cmd=list`
# whenever the FIRST token was a flag silently discarded a real subcommand
# that followed it (`sonde --json run` ran `list`, not `run` -- hf7y/ecosim#30).
cmd=""
flag_args=()
for a in "$@"; do
  if [ -z "$cmd" ] && [ "${a#-}" = "$a" ]; then
    cmd="$a"
  else
    flag_args+=("$a")
  fi
done
verb_parse "${flag_args[@]+"${flag_args[@]}"}"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"

case "$cmd" in
  '')
    printf '%s -- %s\n\n' "$VERB_NAME" "$VERB_SUMMARY"
    printf 'subcommands:\n'
    verb_subcommands | sed '/^$/d' | sed 's/^/  /'
    printf '\n(`%s --help` for flags, `man %s` for the contract)\n' "$VERB_NAME" "$VERB_NAME"
    ;;
  help|--help|-h) verb_usage ;;
  list)
    sonde_need bin/ecosim-sensor list
    sonde_run_translated 'list' "$LEGACY_ROOT/bin/ecosim-sensor" list "$@"
    ;;
  contract)
    sonde_need bin/ecosim-sensor contract
    sonde_run_translated 'contract' "$LEGACY_ROOT/bin/ecosim-sensor" contract "$@"
    ;;
  run)
    sonde_need bin/ecosim-sensor run
    # --json is honoured by `run` only (see man/sonde.1 OPTIONS) -- the
    # sensor runtime is the only thing downstream that reads it; forwarding
    # it to list/contract/sweep/selftest would advertise a behaviour none
    # of them have.
    if [ "$VERB_JSON" = 1 ]; then
      sonde_run_translated 'run' "$LEGACY_ROOT/bin/ecosim-sensor" run "$@" --json
    else
      sonde_run_translated 'run' "$LEGACY_ROOT/bin/ecosim-sensor" run "$@"
    fi
    ;;
  sweep)
    sonde_need bin/ecosim-sweep sweep
    sonde_run_translated 'sweep' "$LEGACY_ROOT/bin/ecosim-sweep" "$@"
    ;;
  selftest)
    sonde_need bin/ecosim-sensor selftest
    sonde_run_translated 'selftest' "$LEGACY_ROOT/bin/ecosim-sensor" selftest "$@"
    ;;
  decide)
    verb_gap 'decide: bin/decide.sh is a one-off menu for a past research pass, not a durable promise -- see GAPS.md'
    ;;
  *)
    verb_die "unknown subcommand: $cmd (try \`$VERB_NAME list\`)"
    ;;
esac
