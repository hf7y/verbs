#!/usr/bin/env bash
# veille -- keep watch over the household of machines
#
# A plain shell utility. It costs nothing to run and reaches no paid service
# except where a subcommand explicitly declares a summon.
#
# The subcommand table below was DISCOVERED from tooling that actually exists
# in this tree, not invented. A subcommand backed by a script execs it. One
# the contract names but has nothing behind it reports GAP (exit 4) rather
# than pretending, because an exit-0 no-op is the worst failure available.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=veille
VERB_SUMMARY="keep watch over the household of machines"
VERB_USAGE="veille <subcommand> [args...]"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

# Where the legacy implementation lives, for subcommands that exec it. Read
# from ONE place; never retyped per subcommand.
LEGACY_ROOT="${VEILLE_LEGACY_ROOT:-/home/zach/Documents/Projects/senechal}"

verb_subcommands() {
  printf '%s\n' \
    'apt-hygiene-mandark          run remedies/apt-hygiene-mandark.sh' \
    'bt-mouse-link-stability      run remedies/bt-mouse-link-stability.sh' \
    'crt-dexter-ssh-key           run remedies/crt-dexter-ssh-key.sh' \
    'dexter-wsl-autostart         run remedies/dexter-wsl-autostart.sh' \
    'estate-health-timer          run remedies/estate-health-timer.sh' \
    'plasma-panel-visible         run remedies/plasma-panel-visible.sh' \
    'remote-health-keys           run remedies/remote-health-keys.sh' \
    'scheduler-subdir-migration   run remedies/scheduler-subdir-migration.sh' \
    'svc-vaporwave-dispatch       run remedies/svc-vaporwave-dispatch.sh' \
    'tmux-konsole-title           run remedies/tmux-konsole-title.sh' \
    ''
}

# A leading flag is a flag, not a subcommand. Without this arm `--json`,
# `--quiet` and `--version` reach the subcommand table, exit 2 as "unknown
# subcommand", and contradict this verb's own `--help`, which offers all
# three. The generator's template shipped without the arm that `bin/bashify`
# had already grown for itself.
case "${1:-}" in
  -*) cmd=list ;;
  *)  cmd="${1:-}"; [ $# -gt 0 ] && shift ;;
esac
verb_parse "$@"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"

case "$cmd" in
  ''|list)
    printf '%s -- %s\n\n' "$VERB_NAME" "$VERB_SUMMARY"
    printf 'subcommands (discovered from real tooling):\n'
    verb_subcommands | sed '/^$/d' | sed 's/^/  /'
    printf '\n(`%s --help` for flags, `man %s` for the contract)\n' "$VERB_NAME" "$VERB_NAME"
    ;;
  help|--help|-h) verb_usage ;;
  apt-hygiene-mandark)
    [ -x "$LEGACY_ROOT/remedies/apt-hygiene-mandark.sh" ] || verb_gap 'apt-hygiene-mandark: remedies/apt-hygiene-mandark.sh is not executable or not present'
    exec "$LEGACY_ROOT/remedies/apt-hygiene-mandark.sh" "$@" ;;
  bt-mouse-link-stability)
    [ -x "$LEGACY_ROOT/remedies/bt-mouse-link-stability.sh" ] || verb_gap 'bt-mouse-link-stability: remedies/bt-mouse-link-stability.sh is not executable or not present'
    exec "$LEGACY_ROOT/remedies/bt-mouse-link-stability.sh" "$@" ;;
  crt-dexter-ssh-key)
    [ -x "$LEGACY_ROOT/remedies/crt-dexter-ssh-key.sh" ] || verb_gap 'crt-dexter-ssh-key: remedies/crt-dexter-ssh-key.sh is not executable or not present'
    exec "$LEGACY_ROOT/remedies/crt-dexter-ssh-key.sh" "$@" ;;
  dexter-wsl-autostart)
    [ -x "$LEGACY_ROOT/remedies/dexter-wsl-autostart.sh" ] || verb_gap 'dexter-wsl-autostart: remedies/dexter-wsl-autostart.sh is not executable or not present'
    exec "$LEGACY_ROOT/remedies/dexter-wsl-autostart.sh" "$@" ;;
  estate-health-timer)
    [ -x "$LEGACY_ROOT/remedies/estate-health-timer.sh" ] || verb_gap 'estate-health-timer: remedies/estate-health-timer.sh is not executable or not present'
    exec "$LEGACY_ROOT/remedies/estate-health-timer.sh" "$@" ;;
  plasma-panel-visible)
    [ -x "$LEGACY_ROOT/remedies/plasma-panel-visible.sh" ] || verb_gap 'plasma-panel-visible: remedies/plasma-panel-visible.sh is not executable or not present'
    exec "$LEGACY_ROOT/remedies/plasma-panel-visible.sh" "$@" ;;
  remote-health-keys)
    [ -x "$LEGACY_ROOT/remedies/remote-health-keys.sh" ] || verb_gap 'remote-health-keys: remedies/remote-health-keys.sh is not executable or not present'
    exec "$LEGACY_ROOT/remedies/remote-health-keys.sh" "$@" ;;
  scheduler-subdir-migration)
    [ -x "$LEGACY_ROOT/remedies/scheduler-subdir-migration.sh" ] || verb_gap 'scheduler-subdir-migration: remedies/scheduler-subdir-migration.sh is not executable or not present'
    exec "$LEGACY_ROOT/remedies/scheduler-subdir-migration.sh" "$@" ;;
  svc-vaporwave-dispatch)
    [ -x "$LEGACY_ROOT/remedies/svc-vaporwave-dispatch.sh" ] || verb_gap 'svc-vaporwave-dispatch: remedies/svc-vaporwave-dispatch.sh is not executable or not present'
    exec "$LEGACY_ROOT/remedies/svc-vaporwave-dispatch.sh" "$@" ;;
  tmux-konsole-title)
    [ -x "$LEGACY_ROOT/remedies/tmux-konsole-title.sh" ] || verb_gap 'tmux-konsole-title: remedies/tmux-konsole-title.sh is not executable or not present'
    exec "$LEGACY_ROOT/remedies/tmux-konsole-title.sh" "$@" ;;
  *) verb_die "unknown subcommand: $cmd  (try: $VERB_NAME list)" ;;
esac
