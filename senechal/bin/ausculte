#!/usr/bin/env bash
# ausculte -- examine the estate for health
#
# A plain shell utility. It costs nothing to run and reaches no paid service.
# Parted off from the monolith verb 2026-07-30 (one noun, many verbs): this
# verb owns one coherent domain. A subcommand backed by a script execs it; one
# with nothing behind it reports GAP (exit 4), never an exit-0 no-op.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=ausculte
VERB_SUMMARY="examine the estate for health"
VERB_USAGE="ausculte <subcommand> [args...]"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

LEGACY_ROOT="${AUSCULTE_LEGACY_ROOT:-/home/zach/Documents/Projects/senechal}"
# The silence audit is ecosim's implementation, reached from here by a stated
# path. Declared and overridable rather than guessed -- see ausculte(1)
# ENVIRONMENT, and GAPS.md for why the file has not moved repositories yet.
SILENCE_AUDIT="${AUSCULTE_SILENCE_AUDIT:-/home/zach/Documents/Projects/ecosim/bin/silence-audit.sh}"

# The estate checks speak a legacy dialect -- 0 all as declared / 1 found
# something / 2 could-not-check -- which COLLIDES with this ecosystem's
# vocabulary, where 2 means the caller is wrong. Passing it through reported
# a could-not-look as a usage error, inside the verb whose whole purpose is
# refusing to confuse those. `bashify check` rules code 1 a reserved code and
# refuses a page that documents it, so translating is mandatory, not taste.
run_health() {
  local what="$1"; shift
  local rc=0
  "$@" || rc=$?
  case "$rc" in
    0) return 0 ;;
    1) printf '%s: FLAGS: %s found something\n' "$VERB_NAME" "$what" >&2; exit 8 ;;
    2) verb_blind "$what could not read part of its domain" ;;
    *) verb_broke "$what exited $rc, which its own contract does not define" ;;
  esac
}

verb_subcommands() {
  printf '%s\n' \
    'dead-config                  config referenced but absent' \
    'estate-health                overall estate health roll-up' \
    'no-self-dev                  assert self-dev stays off where required' \
    'parked                       a project parked, with its material proven safe' \
    'silence                      mechanisms that cannot tell silence from clean' \
    'smart-health                 SMART disk health' \
    'verify-all                   run every health check at once' \
    ''
}

# A leading flag is a flag, not a subcommand. Without this arm `--json`,
# `--quiet` and `--version` reach the subcommand table, exit 2 as "unknown
# subcommand", and contradict this verb's own `--help`, which offers all
# three. The generator's template shipped without the arm that `bin/bashify`
# had already grown for itself.
#
# That arm alone let EVERY leading flag through, known or not: `--nonsense`
# and `--summon` (never granted here -- VERB_CAN_SUMMON=0) landed on the
# same subcommand-table path as `--json` and exited 0 instead of the usage
# error the shared runtime would give them. `verb_parse` is called here to
# decide for real -- but only on this one token. A subcommand's own
# trailing flags (`ausculte silence --strict`, for one -- see man/ausculte.1)
# are not this verb's vocabulary to consume; running them through
# `verb_parse` too would reject a flag the backing check actually
# understands, which is why the `*)` arm below still shifts and stops.
case "${1:-}" in
  -*) verb_parse "$@"; cmd=list ;;
  *)  cmd="${1:-}"; [ $# -gt 0 ] && shift || true ;;
esac
case "$cmd" in
  '')
    printf '%s -- %s\n\n' "$VERB_NAME" "$VERB_SUMMARY"
    printf 'subcommands:\n'
    verb_subcommands | sed '/^$/d' | sed 's/^/  /'
    printf '\n(`%s list` for names alone, `man %s` for the contract)\n' "$VERB_NAME" "$VERB_NAME"
    ;;
  list)
    # Names alone, one per line. This is the MACHINE surface: `bashify check`
    # reads it and takes the last word of each line, so a two-column table
    # here makes the gate compare descriptions instead of subcommands.
    verb_subcommands | sed '/^$/d' | awk '{print $1}'
    ;;
  help|--help|-h) verb_usage ;;
  dead-config)
    [ -x "$LEGACY_ROOT/health/dead-config.sh" ] || verb_gap 'dead-config: health/dead-config.sh is not executable or not present'
    run_health dead-config "$LEGACY_ROOT/health/dead-config.sh" "$@" ;;
  estate-health)
    [ -x "$LEGACY_ROOT/health/estate-health.sh" ] || verb_gap 'estate-health: health/estate-health.sh is not executable or not present'
    run_health estate-health "$LEGACY_ROOT/health/estate-health.sh" "$@" ;;
  no-self-dev)
    [ -x "$LEGACY_ROOT/health/no-self-dev.sh" ] || verb_gap 'no-self-dev: health/no-self-dev.sh is not executable or not present'
    run_health no-self-dev "$LEGACY_ROOT/health/no-self-dev.sh" "$@" ;;
  parked)
    # Renamed from `project-unwired` on 2026-08-01, Zach-directed. The old
    # name collided head-on with the [unwired] flag class that `silence`
    # reports, and the two meant OPPOSITE things: here unwired is the goal
    # state (0 = parked and its material is safe), there it is a defect (an
    # executable nothing names). One word, two world-states, inside the verb
    # whose whole job is refusing exactly that.
    [ -x "$LEGACY_ROOT/health/project-unwired.sh" ] || verb_gap 'parked: health/project-unwired.sh is not executable or not present'
    run_health parked "$LEGACY_ROOT/health/project-unwired.sh" "$@" ;;
  silence)
    # United here 2026-08-01, Zach-directed: the estate includes its own
    # instruments, so a mechanism that maps three world-states onto one
    # symbol is unhealthy estate machinery. The implementation still lives in
    # ecosim and is reached by a DECLARED path, never a guessed one.
    [ -x "$SILENCE_AUDIT" ] || verb_gap "silence: $SILENCE_AUDIT is not executable or not present"
    run_health silence "$SILENCE_AUDIT" "$@" ;;
  smart-health)
    [ -x "$LEGACY_ROOT/remedies/smart-health.sh" ] || verb_gap 'smart-health: remedies/smart-health.sh is not executable or not present'
    run_health smart-health "$LEGACY_ROOT/remedies/smart-health.sh" "$@" ;;
  verify-all)
    [ -x "$LEGACY_ROOT/remedies/verify-all.sh" ] || verb_gap 'verify-all: remedies/verify-all.sh is not executable or not present'
    run_health verify-all "$LEGACY_ROOT/remedies/verify-all.sh" "$@" ;;
  *) verb_gap "unknown subcommand: $cmd (try \`list\`)" ;;
esac
