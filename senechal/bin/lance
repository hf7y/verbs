#!/usr/bin/env bash
# lance -- launch windows, browsers and panes
#
# A plain shell utility. It costs nothing to run and reaches no paid service.
# Parted off from the monolith verb 2026-07-30 (one noun, many verbs): this
# verb owns one coherent domain. A subcommand backed by a script execs it; one
# with nothing behind it reports GAP (exit 4), never an exit-0 no-op.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=lance
VERB_SUMMARY="launch windows, browsers and panes"
VERB_USAGE="lance <subcommand> [args...]"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

LEGACY_ROOT="${LANCE_LEGACY_ROOT:-/home/zach/Documents/Projects/senechal}"

verb_subcommands() {
  printf '%s\n' \
    'browse                       open a URL the estate way' \
    'spawn-here                   spawn a terminal in this directory' \
    'window-spawn-desktop         place a spawned window on its desktop' \
    ''
}

# A leading flag is a flag, not a subcommand. Without this arm `--json`,
# `--quiet` and `--version` reach the subcommand table, exit 2 as "unknown
# subcommand", and contradict this verb's own `--help`, which offers all
# three. The generator's template shipped without the arm that `bin/bashify`
# had already grown for itself.
#
# That arm alone let EVERY leading flag through, known or not: `--nonsense`
# and `--summon` (never granted here -- VERB_CAN_SUMMON=0) landed on the
# same subcommand-table path as `--json` and exited 0 instead of the usage
# error the shared runtime would give them. `verb_parse` is called here to
# decide for real -- but only on this one token. A subcommand's own
# trailing flags (`lance browse --where`, for one) are not this verb's
# vocabulary to consume; running them through `verb_parse` too would
# reject a flag the backing tool actually understands, which is why the
# `*)` arm below still shifts and stops.
case "${1:-}" in
  -*) verb_parse "$@"; cmd=list ;;
  *)  cmd="${1:-}"; [ $# -gt 0 ] && shift || true ;;
esac
case "$cmd" in
  ''|list)
    printf '%s -- %s\n\n' "$VERB_NAME" "$VERB_SUMMARY"
    printf 'subcommands:\n'
    verb_subcommands | sed '/^$/d' | sed 's/^/  /'
    printf '\n(`man %s` for the contract)\n' "$VERB_NAME"
    ;;
  help|--help|-h) verb_usage ;;
  browse)
    [ -x "$LEGACY_ROOT/tools/browse" ] || verb_gap 'browse: tools/browse is not executable or not present'
    exec "$LEGACY_ROOT/tools/browse" "$@" ;;
  spawn-here)
    [ -x "$LEGACY_ROOT/tools/spawn-here" ] || verb_gap 'spawn-here: tools/spawn-here is not executable or not present'
    exec "$LEGACY_ROOT/tools/spawn-here" "$@" ;;
  window-spawn-desktop)
    [ -x "$LEGACY_ROOT/remedies/window-spawn-desktop.sh" ] || verb_gap 'window-spawn-desktop: remedies/window-spawn-desktop.sh is not executable or not present'
    exec "$LEGACY_ROOT/remedies/window-spawn-desktop.sh" "$@" ;;
  *) verb_gap "unknown subcommand: $cmd (try \`list\`)" ;;
esac
