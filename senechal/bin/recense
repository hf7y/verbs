#!/usr/bin/env bash
# recense -- take a census of the executables installed under a home directory
#
# Not a wrapper. There was no legacy script behind this verb; the census is
# a filesystem and environment walk, so it is written here in full and costs
# nothing to run. See man/recense.1 -- the page is the contract, this is the
# attempt to satisfy it.
#
# The distinction the whole utility exists to hold: INSTALLED (a search path
# entry reaches it) versus PRESENT (it has the execute bit and lives under
# $HOME). Confusing the second for the first is the reason `find $HOME -perm
# -111` is not this program.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=recense
VERB_SUMMARY="take a census of the executables installed under a home directory"
VERB_USAGE="recense [where <name>|shadowed|unwired|paths] [flags]"
VERB_CAN_SUMMON=0
VERB_EXITS="0 kept  2 usage  6 blind  9 nothing matched"
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

HOME_DIR="${HOME:?recense: HOME is unset; there is no home to take a census of}"

# Conventional install targets. `unwired` looks HERE and not across the whole
# home directory on purpose -- a full walk answers the PRESENT question, which
# is a different and much larger question nobody asked.
CONVENTIONAL_DIRS=(
  "$HOME_DIR/bin"
  "$HOME_DIR/.local/bin"
  "$HOME_DIR/.cargo/bin"
  "$HOME_DIR/go/bin"
  "$HOME_DIR/.npm-global/bin"
  "$HOME_DIR/.local/share/pnpm"
  "$HOME_DIR/.bun/bin"
  "$HOME_DIR/.deno/bin"
  "$HOME_DIR/.pyenv/shims"
  "$HOME_DIR/.rbenv/shims"
  "$HOME_DIR/.rye/shims"
)

# ------------------------------------------------------------------ helpers

# Search path entries under $HOME, in search order, duplicates PRESERVED.
# Collapsing a duplicate would hide a shell configuration defect that this
# utility is better placed to see than anything else on the machine.
home_path_dirs() {
  local IFS=:
  local d
  for d in $PATH; do
    [ -n "$d" ] || continue
    case "$d" in "$HOME_DIR"|"$HOME_DIR"/*) printf '%s\n' "$d" ;; esac
  done
}

# Every subcommand calls this FIRST, in the parent shell. It cannot live inside
# dir_execs: that runs in a command substitution, where `exit 6` kills only the
# subshell and the loop carries on printing a count of 0 for a directory it
# could not read -- an unreadable directory reported as an empty one, which is
# the exact confusion exit 6 exists to prevent. Caught 2026-07-31 by provoking
# the code rather than by reading the function.
assert_readable() {
  local d
  while IFS= read -r d; do
    [ -d "$d" ] || continue
    [ -r "$d" ] && [ -x "$d" ] || verb_blind "cannot read search path entry: $d"
  done < <(home_path_dirs)
}

# Executable basenames provided by one directory.
dir_execs() {
  local d="$1" f
  [ -d "$d" ] || return 0
  [ -r "$d" ] && [ -x "$d" ] || return 0   # unreachable: assert_readable ran first
  for f in "$d"/*; do
    [ -e "$f" ] || continue      # unmatched glob, or a dangling symlink
    [ -f "$f" ] && [ -x "$f" ] || continue
    printf '%s\n' "${f##*/}"
  done
}

# name<TAB>path for every installed executable, first provider in search order
# wins, one line per name.
census() {
  local d n seen=" "
  while IFS= read -r d; do
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      case "$seen" in *" $n "*) continue ;; esac
      seen="$seen$n "
      printf '%s\t%s/%s\n' "$n" "$d" "$n"
    done < <(dir_execs "$d")
  done < <(home_path_dirs) | LC_ALL=C sort -u -k1,1
}

emit_json_pairs() {   # stdin: key<TAB>value ...
  local first=1 line
  printf '[\n'
  while IFS= read -r line; do
    [ $first = 1 ] || printf ',\n'
    first=0
    printf '  {"name": "%s", "path": "%s"}' "${line%%	*}" "${line#*	}"
  done
  [ $first = 1 ] || printf '\n'
  printf ']\n'
}

note() { [ "$VERB_QUIET" = 1 ] || printf '%s: %s\n' "$VERB_NAME" "$*" >&2; }

# --------------------------------------------------------------- subcommands

do_census() {
  local out; out="$(census)"
  if [ "$VERB_JSON" = 1 ]; then
    printf '%s\n' "$out" | sed '/^$/d' | emit_json_pairs
  else
    [ -n "$out" ] && printf '%s\n' "$out"
  fi
  [ -n "$out" ] || { note "no executables installed under $HOME_DIR are on PATH"; return 9; }
  note "$(printf '%s\n' "$out" | wc -l) installed under $HOME_DIR"
  return 0
}

do_where() {
  local name="${1:-}"
  [ -n "$name" ] || verb_die "where: needs a name  (try --help)"
  local home_provider actual
  home_provider="$(census | awk -F'\t' -v n="$name" '$1 == n {print $2; exit}')"
  actual="$(command -v -- "$name" 2>/dev/null || true)"

  if [ -z "$home_provider" ]; then
    if [ "$VERB_JSON" = 1 ]; then
      printf '{"name": "%s", "installed_under_home": false, "resolves_to": "%s"}\n' "$name" "$actual"
    else
      note "$name is not installed under $HOME_DIR"
      [ -n "$actual" ] && note "the shell would run $actual (outside this home)"
    fi
    return 9
  fi

  local wins=false
  [ "$actual" = "$home_provider" ] && wins=true
  if [ "$VERB_JSON" = 1 ]; then
    printf '{"name": "%s", "installed_under_home": true, "provider": "%s", "wins": %s, "resolves_to": "%s"}\n' \
      "$name" "$home_provider" "$wins" "$actual"
  else
    printf '%s\t%s\n' "$name" "$home_provider"
    if [ "$wins" = false ]; then
      note "SHADOWED: the shell would run ${actual:-nothing}, not $home_provider"
    fi
  fi
  return 0
}

do_shadowed() {
  local n p actual found=0 out=''
  while IFS=$'\t' read -r n p; do
    [ -n "$n" ] || continue
    actual="$(command -v -- "$n" 2>/dev/null || true)"
    [ "$actual" = "$p" ] && continue
    found=1
    out="$out$n	$p	${actual:-<unresolvable>}
"
  done < <(census)
  if [ "$VERB_JSON" = 1 ]; then
    printf '%s' "$out" | awk -F'\t' 'BEGIN{print "["; s=""} NF{printf "%s  {\"name\": \"%s\", \"home_provider\": \"%s\", \"wins\": \"%s\"}", s, $1, $2, $3; s=",\n"} END{print ""; print "]"}'
  else
    [ -n "$out" ] && printf '%s' "$out"
  fi
  [ "$found" = 1 ] || { note "nothing installed under $HOME_DIR is shadowed"; return 9; }
  return 0
}

do_unwired() {
  local d n on_path found=0 out='' dirs_out=''
  local path_dirs; path_dirs="$(home_path_dirs)"
  for d in "${CONVENTIONAL_DIRS[@]}"; do
    [ -d "$d" ] || continue
    on_path=0
    while IFS= read -r p; do [ "$p" = "$d" ] && on_path=1; done <<< "$path_dirs"
    [ "$on_path" = 1 ] && continue
    found=1
    dirs_out="$dirs_out$d
"
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      out="$out$n	$d/$n
"
    done < <(dir_execs "$d")
  done
  if [ "$VERB_JSON" = 1 ]; then
    printf '%s' "$out" | sed '/^$/d' | emit_json_pairs
  else
    if [ "$found" = 1 ]; then
      note "install directories absent from PATH:"
      [ "$VERB_QUIET" = 1 ] || printf '%s' "$dirs_out" | sed 's/^/  /' >&2
    fi
    [ -n "$out" ] && printf '%s' "$out"
  fi
  [ "$found" = 1 ] || { note "every conventional install directory under $HOME_DIR is on PATH"; return 9; }
  return 0
}

do_paths() {
  local d count seen=" " dup
  local any=0
  while IFS= read -r d; do
    any=1
    count="$(dir_execs "$d" | wc -l)"
    dup=''
    case "$seen" in *" $d "*) dup="	DUPLICATE" ;; *) seen="$seen$d " ;; esac
    if [ "$VERB_JSON" = 1 ]; then
      printf '{"path": "%s", "executables": %s, "duplicate": %s}\n' \
        "$d" "$count" "$([ -n "$dup" ] && echo true || echo false)"
    else
      printf '%s\t%s%s\n' "$count" "$d" "$dup"
    fi
  done < <(home_path_dirs)
  [ "$any" = 1 ] || { note "no PATH entry lies under $HOME_DIR"; return 9; }
  return 0
}

# --------------------------------------------------------------------- main
verb_parse "$@"
set -- ${VERB_ARGS+"${VERB_ARGS[@]}"}

# A leading flag is a flag, not a subcommand. Without this arm `--json`,
# `--quiet` and `--version` reach the subcommand table, exit 2 as "unknown
# subcommand", and contradict this verb's own `--help`, which offers all
# three. The generator's template shipped without the arm that `bin/bashify`
# had already grown for itself.
case "${1:-}" in
  -*) cmd=list ;;
  *)  cmd="${1:-}"; [ $# -gt 0 ] && shift || true ;;
esac
case "$cmd" in
  '')          assert_readable; do_census ;;
  where)       [ $# -gt 0 ] || verb_die "where: needs a name  (try --help)"
               assert_readable; do_where "$@" ;;
  shadowed)    assert_readable; do_shadowed ;;
  unwired)     assert_readable; do_unwired ;;
  paths)       assert_readable; do_paths ;;
  # No `list`/`help` subcommand: bare `recense` is the census, not a menu, and
  # an undocumented subcommand fails row 3 of THE PAGE TEST as hard as a
  # documented ghost. `--help` is the one help route and it is on the page.
  *)           verb_die "unknown subcommand: $cmd  (try --help)" ;;
esac
